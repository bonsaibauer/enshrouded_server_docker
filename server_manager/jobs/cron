#!/usr/bin/env bash

SCRIPT_DIR="$(cd -P "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" >/dev/null 2>&1 && pwd)"
# shellcheck source=server_manager/lib/log
. "${SCRIPT_DIR}/../lib/log"
# shellcheck source=server_manager/jobs_core/profile
. "${SCRIPT_DIR}/../jobs_core/profile"

COMMAND_ROOT="${COMMAND_ROOT:-${SCRIPT_DIR}/../commands}"
CRON_EXEC_ACTION="${CRON_EXEC_ACTION:-sync}"

JOB_UPDATE_BIN="${JOB_UPDATE_BIN:-/usr/local/etc/enshrouded/jobs/update}"
JOB_BACKUP_BIN="${JOB_BACKUP_BIN:-/usr/local/etc/enshrouded/jobs/backup}"
JOB_RESTART_BIN="${JOB_RESTART_BIN:-/usr/local/etc/enshrouded/jobs/restart}"

usage() {
  cat <<'EOF'
Usage:
  cron

Configuration via ENV:
  CRON_EXEC_ACTION=sync|start|stop|restart|status
EOF
}

require_executable() {
  local file
  file="$1"
  [[ -x "$file" ]] || fatal "Command is not executable: $file"
}

cron_append() {
  local out_file schedule command_line label
  out_file="$1"
  schedule="$2"
  command_line="$3"
  label="$4"

  [[ -n "$schedule" ]] || return 0
  info "Adding cron entry for ${label}: ${schedule}"
  printf "%s %s >/dev/null 2>&1\n" "$schedule" "$command_line" >>"$out_file"
}

sync_crontab() {
  local update_cron backup_cron restart_cron crontab_file

  update_cron="$(resolve_from_env_or_manager "UPDATE_CRON" ".updateCron" "")"
  backup_cron="$(resolve_from_env_or_manager "BACKUP_CRON" ".backupCron" "")"
  restart_cron="$(resolve_from_env_or_manager "RESTART_CRON" ".restartCron" "")"

  require_executable "${COMMAND_ROOT}/check/check-cron"
  "${COMMAND_ROOT}/check/check-cron" --format json >/dev/null

  crontab_file="$(mktemp)"
  cron_append "$crontab_file" "$update_cron" "$JOB_UPDATE_BIN" "update checks"
  cron_append "$crontab_file" "$backup_cron" "$JOB_BACKUP_BIN" "scheduled backups"
  cron_append "$crontab_file" "$restart_cron" "$JOB_RESTART_BIN" "scheduled restarts"

  if [[ ! -s "$crontab_file" ]]; then
    info "No schedules configured - clearing crontab"
  else
    info "Applying crontab entries"
  fi
  crontab "$crontab_file"
  rm -f "$crontab_file"
}

run_crond_service_action() {
  local action
  action="$1"
  case "$action" in
    start|stop|status)
      supervisorctl "$action" crond
      ;;
    restart)
      supervisorctl stop crond || true
      supervisorctl start crond
      ;;
    *)
      fatal "Invalid CRON_EXEC_ACTION: $action"
      ;;
  esac
}

main() {
  case "${1-}" in
    --help|-h|help)
      usage
      exit 0
      ;;
    "")
      ;;
    *)
      fatal "cron job does not accept arguments"
      ;;
  esac

  info "Running cron job dispatcher (action=${CRON_EXEC_ACTION})"
  case "$CRON_EXEC_ACTION" in
    sync|"")
      sync_crontab
      ;;
    start|stop|restart|status)
      run_crond_service_action "$CRON_EXEC_ACTION"
      ;;
    *)
      fatal "Invalid CRON_EXEC_ACTION: $CRON_EXEC_ACTION"
      ;;
  esac
}

main "$@"
