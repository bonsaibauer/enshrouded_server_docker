  else
    ui_warn "Backup failed or timed out."
  fi

  ui_pause
  return 0
}

menu_run_config_backup_now() {
  local choice selector

  while :; do
    ui_header "Create Config Backup"
    ui_info "Creates a config-only ZIP under BACKUP_DIR/manual."
    echo
    ui_opt 1 "Enshrouded config only"
    ui_opt 2 "Server Manager config only"
    ui_opt 3 "Both config files"
    echo
    ui_actions_bar "b Back" "m Main" "x Exit"
