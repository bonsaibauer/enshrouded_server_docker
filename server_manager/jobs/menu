MENU_NAV=""
MENU_POST_HOOK_RAN="false"

menu_run_post_hook_once() {
  if [[ "$MENU_POST_HOOK_RAN" == "true" ]]; then
    return 0
  fi
  MENU_POST_HOOK_RAN="true"
  if [[ -n "${MENU_SPEC_TMP_FILE:-}" ]]; then
    rm -f "$MENU_SPEC_TMP_FILE" 2>/dev/null || true
    MENU_SPEC_TMP_FILE=""
  fi
  server_run hook-run "menu post" "${MENU_POST_HOOK:-}"
}

menu_execute_action_by_type() {
  local action_name action_json action_type
  local requires_running confirm_raw confirm_message
  local command_name fn
  local -a internal_args command_args

  action_name="$1"
  action_json="$2"

  action_type="$(jq -r '.type // empty' <<<"$action_json" 2>/dev/null || true)"
  if [[ -z "$action_type" || "$action_type" == "null" ]]; then
    ui_warn "Action '${action_name}' has no valid type."
    ui_pause
    return 1
  fi

  requires_running="$(jq -r '(.requiresRunning // false) | tostring' <<<"$action_json" 2>/dev/null || echo "false")"
  if [[ "$requires_running" == "true" ]] && ! is_supervisor_running "server"; then
    ui_warn "Action '${action_name}' requires the server to be running."
    ui_pause
    return 1
  fi

  confirm_raw="$(jq -r '
    if has("confirm") then
      if (.confirm | type) == "boolean" then
        (if .confirm then "true" else "false" end)
      elif (.confirm | type) == "string" then
        .confirm
      else
        "false"
      end
    else
      "false"
    end
  ' <<<"$action_json" 2>/dev/null || echo "false")"

  confirm_message=""
  if [[ "$confirm_raw" == "true" ]]; then
    confirm_message="Execute action '${action_name}'?"
  elif [[ "$confirm_raw" != "false" && -n "$confirm_raw" ]]; then
    confirm_message="$confirm_raw"
  fi

  if [[ -n "$confirm_message" ]]; then
    if ! ui_confirm_yes_no "$confirm_message"; then
      ui_info "Cancelled."
      ui_pause
      return 0
    fi
  fi

  case "$action_type" in
    server)
      command_name="$(jq -r '.command // empty' <<<"$action_json" 2>/dev/null || true)"
      if [[ -z "$command_name" || "$command_name" == "null" ]]; then
        ui_warn "Action '${action_name}' is missing command."
        ui_pause
        return 1
      fi

      mapfile -t command_args < <(jq -r 'if (.args | type) == "array" then .args[] | tostring else empty end' <<<"$action_json" 2>/dev/null || true)
      ui_hr
      case "$command_name" in
        start)
          ui_info "Running: bootstrap + start"
          echo
          menu_start_server_via_bootstrap || true
          ;;
        restart)
          if is_supervisor_running "server"; then
            ui_info "Running: server restart"
            echo
            server_run restart "${command_args[@]}" || true
          else
            ui_info "Server is STOPPED. Running: bootstrap + start"
            echo
            menu_start_server_via_bootstrap || true
          fi
          ;;
        *)
          if [[ "${#command_args[@]}" -gt 0 ]]; then
            ui_info "Running: server $command_name ${command_args[*]}"
          else
            ui_info "Running: server $command_name"
          fi
          echo
          server_run "$command_name" "${command_args[@]}" || true
          ;;
      esac
      echo
      ui_pause
      ;;

    internal)
      fn="$(jq -r '.fn // empty' <<<"$action_json" 2>/dev/null || true)"
      if [[ -z "$fn" || "$fn" == "null" ]]; then
        ui_warn "Action '${action_name}' is missing 'fn'."
        ui_pause
        return 1
      fi

      if ! [[ "$fn" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
        ui_warn "Invalid internal function name in action '${action_name}': $fn"
        ui_pause
        return 1
      fi

      if ! declare -F "$fn" >/dev/null 2>&1; then
        ui_warn "Internal function not found for action '${action_name}': $fn"
        ui_pause
        return 1
      fi

      mapfile -t internal_args < <(jq -r 'if (.args | type) == "array" then .args[] | tostring else empty end' <<<"$action_json" 2>/dev/null || true)
      "$fn" "${internal_args[@]}"
      ;;

    *)
      ui_warn "Unknown action type '${action_type}' for action '${action_name}'."
      ui_pause
      return 1
      ;;
  esac

  return 0
}

menu_dispatch_action() {
  local action_name action_json
  action_name="$1"

  if ! menu_spec_ready; then
    ui_fatal "Menu specification unavailable: ${MENU_SPEC_FILE}"
  fi

  action_json="$(menu_spec_query -c --arg action "$action_name" '.actions[$action] // empty' || true)"
  if [[ -z "$action_json" || "$action_json" == "null" ]]; then
    ui_warn "Unknown menu action: ${action_name}"
    ui_pause
    return 1
  fi

  menu_execute_action_by_type "$action_name" "$action_json"
}

menu_load_screen() {
  local screen title choice action main_screen
  local key label action_id nav_value
  local -a entries

  screen="$1"
  title="${2:-}"
  if [[ -z "$title" ]]; then
    if [[ "$screen" == "main" ]]; then
      title="Main Menu"
    else
      title="$screen"
    fi
  fi

  if ! menu_spec_ready; then
    ui_fatal "Menu specification unavailable: ${MENU_SPEC_FILE}"
  fi

  if [[ "$screen" == "main" ]]; then
    main_screen="true"
  else
    main_screen="false"
  fi

  while :; do
    if menu_nav_is_set; then
      nav_value="$(menu_nav_value)"
      case "$nav_value" in
        main)
          if [[ "$screen" == "main" ]]; then
            menu_nav_clear
          else
            return 0
          fi
          ;;
        exit)
          return 0
          ;;
      esac
    fi

    mapfile -t entries < <(menu_spec_query --arg screen "$screen" '
      (.screens[$screen] // [])
      | map(select((.key // "") != "" and (.action // "") != ""))
      | .[]
      | "\(.key)|\((.title // .label // .action))|\(.action)"
    ' || true)

    if [[ "${#entries[@]}" -eq 0 ]]; then
      ui_fatal "Menu screen '${screen}' missing or empty in ${MENU_SPEC_FILE}"
    fi

    ui_header "$title" "$main_screen"
    for action in "${entries[@]}"; do
      IFS='|' read -r key label action_id <<<"$action"
      [[ -z "$key" || -z "$action_id" ]] && continue
      ui_opt "$key" "$label"
    done
    echo

    if [[ "$screen" == "main" ]]; then
      ui_actions_bar "x Exit"
    else
      ui_actions_bar "b Back" "m Main" "x Exit"
    fi
    echo

    choice="$(menu_prompt_nav_choice "Choice" "$main_screen")"
    if menu_nav_choice_is_handled "$choice"; then
      return 0
    fi

    action_id=""
    for action in "${entries[@]}"; do
      IFS='|' read -r key label action_id <<<"$action"
      [[ -z "$key" || -z "$action_id" ]] && continue
      if [[ "$key" == "$choice" ]]; then
        break
      fi
      action_id=""
    done

    if [[ -z "$action_id" ]]; then
      ui_warn "Invalid selection."
      ui_pause
      continue
    fi

    menu_dispatch_action "$action_id" || true
    if [[ "$MENU_ONCE" == "true" ]]; then
      return 0
    fi
  done
}

main() {
  parse_args "$@"
  info "Running interactive menu (start_screen=${MENU_START_SCREEN}, once=${MENU_ONCE})"
  menu_capture_external_env_overrides
  init_runtime_env

  if ! menu_spec_init; then
    ui_fatal "Menu specification unavailable: ${MENU_SPEC_CSV_FILE}"
  fi

  trap menu_run_post_hook_once EXIT
  server_run hook-run "menu pre" "${MENU_PRE_HOOK:-}"
  if [[ "$MENU_START_SCREEN" == "main" ]]; then
    menu_load_screen "$MENU_START_SCREEN" "Main Menu"
  else
    menu_load_screen "$MENU_START_SCREEN"
  fi

  case "${MENU_NAV:-}" in
    exit)
      # On exit, offer to start the server if it is currently stopped.
      if ! is_supervisor_running "server"; then
        ui_clear
        ui_banner
        ui_warn "The Enshrouded server is currently STOPPED."
        echo
        menu_prompt_start_server "Do you want me to start server before exiting?"
      fi
      ;;
  esac

  menu_run_post_hook_once
  success "Interactive menu complete (nav=${MENU_NAV:-unknown})"
}

main "$@"

