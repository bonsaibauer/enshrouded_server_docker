# --- inlined menu module: editor_spec_json ---
# Generic, spec-driven JSON editor helpers for the interactive menu.
# Validation/type hints come from `server_manager/env/env_server_manager.csv`
# and `server_manager/env/env_enshrouded_server.csv`.
# Menu actions/order/grouping/path mappings come from `server_manager/env/menu.csv`.

menu_spec_editor__json_get_scalar() {
  # Prints the scalar as a string, but keeps `false` and `0` visible.
  local file path
  file="$1"
  path="$2"
  jq -r "$path | if . == null then empty else tostring end" "$file" 2>/dev/null || echo ""
}

menu_spec_editor__json_get_csv_list() {
  # Prints a CSV representation of a JSON array (used for list env values).
  local file path
  file="$1"
  path="$2"
  jq -r "$path // [] | if type == \"array\" then join(\",\") else empty end" "$file" 2>/dev/null || echo ""
}

menu_spec_editor__session_backup_if_needed() {
  # Create exactly one config backup per edit session (first write wins).
  # Uses dynamic scope: the calling editor sets `backed_up=false` locally.
  local backup_job
  backup_job="${1-}"

  if [[ -z "$backup_job" ]]; then
    return 0
  fi
  if [[ "${backed_up:-false}" == "true" ]]; then
    return 0
  fi
  ui_info "Creating config backup (logged via Supervisor)..."
  menu_run_config_backup_job "$backup_job" || true
  backed_up="true"
  return 0
}

menu_spec_editor__set_jq() {
  # Apply a jq transform to $file atomically.
  local file dir base tmp err_file err_last
  file="$1"
  shift

  if [[ -z "$file" || ! -f "$file" ]]; then
    ui_warn "Cannot save: config file missing: ${file:-<empty>}"
    return 1
  fi

  dir="$(dirname "$file")"
  base="$(basename "$file")"
  if [[ ! -w "$dir" ]]; then
    ui_warn "Cannot save: no write permission for directory: $dir"
    return 1
  fi

  tmp="$(mktemp "${dir}/.${base}.menu.XXXXXX" 2>/dev/null || mktemp)"
  err_file="$(mktemp)"

  if jq "$@" "$file" >"$tmp" 2>"$err_file"; then
    if mv -f "$tmp" "$file"; then
      chmod 600 "$file" 2>/dev/null || true
      chown enshrouded:enshrouded "$file" 2>/dev/null || true
      rm -f "$err_file" 2>/dev/null || true
      return 0
    fi
    ui_warn "Cannot save: failed to replace file: $file"
  else
    err_last="$(awk 'NF{last=$0} END{print last}' "$err_file" 2>/dev/null || true)"
    [[ -z "$err_last" ]] && err_last="jq update failed"
    ui_warn "Cannot save: $err_last"
  fi
  rm -f "$tmp" 2>/dev/null || true
  rm -f "$err_file" 2>/dev/null || true
  return 1
}

menu_spec_editor__json_path_to_array_json() {
  # Converts a restricted jq-style path (e.g. .a.b[0].c) to JSON array form.
  # Supported segments: .name and [<index>].
  local raw path rest key idx out first
  raw="$1"
  path="$(printf "%s" "$raw" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  [[ -n "$path" ]] || return 1
  [[ "$path" == .* || "$path" == \[* ]] || return 1

  rest="$path"
  out="["
  first=1

  while [[ -n "$rest" ]]; do
    if [[ "$rest" == .* ]]; then
      rest="${rest#.}"
    fi

    if [[ "$rest" =~ ^([A-Za-z_][A-Za-z0-9_]*)(.*)$ ]]; then
      key="${BASH_REMATCH[1]}"
      rest="${BASH_REMATCH[2]}"
      if [[ "$first" -eq 0 ]]; then
        out+=","
      fi
      out+="\"$key\""
      first=0
    fi

    while [[ "$rest" =~ ^\[([0-9]+)\](.*)$ ]]; do
      idx="${BASH_REMATCH[1]}"
      rest="${BASH_REMATCH[2]}"
      if [[ "$first" -eq 0 ]]; then
        out+=","
      fi
      out+="$idx"
      first=0
    done

    if [[ -z "$rest" ]]; then
      break
    fi
    if [[ "$rest" == .* ]]; then
      continue
    fi
    return 1
  done

  out+="]"
  printf "%s" "$out"
}

menu_spec_editor__set_path_with_jq() {
  # Safe setter that avoids injecting the raw path into jq program text.
  local file json_path path_array_json
  file="$1"
  json_path="$2"
  shift 2

  path_array_json="$(menu_spec_editor__json_path_to_array_json "$json_path" 2>/dev/null || true)"
  if [[ -z "$path_array_json" ]]; then
    ui_warn "Cannot save: unsupported JSON path mapping: ${json_path:-<empty>}"
    return 1
  fi

  menu_spec_editor__set_jq "$file" --argjson p "$path_array_json" "$@" 'setpath($p; $val)'
}

menu_spec_editor__block_if_env_locked() {
  # Returns 0 if editable, 1 if locked by external env override.
  local env_var env_value env_mode
  env_var="$1"

  if ! menu_env_override_is_set "$env_var"; then
    return 0
  fi

  env_mode="$(validation_env_mode "$env_var" 2>/dev/null || echo "soft")"
  env_value="$(menu_env_override_value "$env_var")"
  if [[ "$env_mode" == "hard" || "$env_mode" == "deferred" ]]; then
    ui_warn "This setting is hard ENV-managed and cannot be edited here."
    if [[ -n "$env_value" ]]; then
      ui_kv "ENV" "$env_var=$(menu_env_override_pretty_value "$env_var" "$env_value")"
    else
      ui_kv "ENV" "$env_var=<required hard env>"
    fi
    ui_info "Set it via container environment (e.g. docker run/docker compose), then restart container."
  else
    ui_warn "This setting is controlled by an environment variable and cannot be edited here."
    ui_kv "ENV" "$env_var=$(menu_env_override_pretty_value "$env_var" "$env_value")"
    ui_info "Remove it from your docker-compose/container environment to edit this value."
  fi
  ui_pause
  return 1
}

menu_spec_editor__display_value_for_var() {
  local file env_var json_path empty_label rule
  file="$1"
  env_var="$2"
  json_path="$3"
  empty_label="${4:-<empty>}"

  if menu_env_override_is_set "$env_var"; then
    local raw
    raw="$(menu_env_lock_value_for_display "$file" "$env_var" "$json_path")"
    if [[ -z "$raw" ]]; then
      printf "%s" "${C_DIM}${empty_label}${C_RESET}"
    else
      printf "%s%s%s" "${C_RED}" "$raw" "${C_RESET}"
    fi
    return 0
  fi

  rule="$(validation_rule_json "$env_var" 2>/dev/null || true)"
  if jq -e '(.val_list|type) == "object"' <<<"$rule" >/dev/null 2>&1; then
    local csv
    csv="$(menu_spec_editor__json_get_csv_list "$file" "$json_path")"
    if [[ -z "$csv" ]]; then
      printf "%s" "${C_DIM}${empty_label}${C_RESET}"
    else
      printf "%s%s%s" "${C_GREEN}" "$csv" "${C_RESET}"
    fi
    return 0
  fi

  local raw
  raw="$(menu_spec_editor__json_get_scalar "$file" "$json_path")"
  if [[ -z "$raw" ]]; then
    printf "%s" "${C_DIM}${empty_label}${C_RESET}"
  else
    printf "%s%s%s" "${C_GREEN}" "$raw" "${C_RESET}"
  fi
}

menu_spec_editor__description_for_var() {
  local env_var desc hint out
  env_var="$1"

  desc="$(validation_env_description "$env_var" 2>/dev/null || true)"
  hint="$(validation_env_allowed_hint "$env_var" 2>/dev/null || true)"

  out=""
  if [[ -n "$desc" ]]; then
    out="$desc"
  fi
  if [[ -n "$hint" ]]; then
    if [[ -n "$out" ]]; then
      out="${out} | ${hint}"
    else
      out="$hint"
    fi
  fi

  if [[ -z "$out" ]]; then
    out="-"
  fi

  printf "%s" "$out"
}

menu_spec_editor__prompt_value_from_options() {
  # Prompt as numeric choice over a fixed set of values.
  local prompt choice selected_idx i
  prompt="${1:-New value}"
  shift || true
  local -a options
  options=("$@")

  if [[ "${#options[@]}" -le 0 ]]; then
    printf ""
    return 0
  fi

  while :; do
    for i in "${!options[@]}"; do
      ui_opt "$((i + 1))" "${options[$i]}"
    done
    choice="$(ui_prompt_choice "$prompt")"
    if [[ -z "$choice" ]]; then
      printf ""
      return 0
    fi

    selected_idx="$(menu_choice_index "$choice" "${#options[@]}" || true)"
    if [[ -n "$selected_idx" ]]; then
      printf "%s" "${options[$selected_idx]}"
      return 0
    fi

    ui_warn "Invalid selection. Enter a number between 1 and ${#options[@]}."
  done
}

menu_spec_editor__prompt_value() {
  # Prompts for a new value. Prints the raw input to stdout.
  local env_var label current empty_action bool_toggle
  env_var="$1"
  label="$2"
  current="$3"
  empty_action="${4:-cancel}"   # cancel|null|clear_list
  bool_toggle="${5:-false}"

  local type env_mode rule enum_count
  type="$(validation_env_type "$env_var" 2>/dev/null || true)"
  [[ -z "$type" ]] && type="string"
  rule="$(validation_rule_json "$env_var" 2>/dev/null || true)"
  enum_count="$(jq -r 'if (.val_enum|type) == "array" then (.val_enum|length) else 0 end' <<<"$rule" 2>/dev/null || echo "0")"
  if ! [[ "$enum_count" =~ ^[0-9]+$ ]]; then
    enum_count=0
  fi

  echo
  ui_kv "Field" "$label"
  ui_kv "Current" "${current:-<empty>}"

  env_mode="$(validation_env_mode "$env_var" 2>/dev/null || echo "soft")"
  if [[ "$type" == "bool" && "$bool_toggle" == "true" ]]; then
    ui_info "Enter = toggle"
  else
    if [[ "$env_mode" == "hard" || "$env_mode" == "deferred" ]]; then
      ui_info "Empty is not allowed"
    else
      case "$empty_action" in
        null)
          ui_info "Empty = null"
          ;;
        clear_list)
          ui_info "Empty = clear"
          ;;
        *)
          ui_info "Empty = cancel"
          ;;
      esac
    fi
  fi
  echo

  local value v
  if [[ "$type" == "bool" ]]; then
    value="$(menu_spec_editor__prompt_value_from_options "New value (1-2)" "true" "false")"
  elif [[ "$enum_count" -gt 0 ]]; then
    local -a enum_values
    enum_values=()
    while IFS= read -r v; do
      enum_values+=("$v")
    done < <(jq -r '.val_enum[] | tostring' <<<"$rule" 2>/dev/null || true)

    value="$(menu_spec_editor__prompt_value_from_options "New value (1-${#enum_values[@]})" "${enum_values[@]}")"
  else
    value="$(ui_read "New value: ")"
    value="$(echo "$value" | xargs)"
  fi

  printf "%s" "$value"
}

menu_spec_editor__edit_var() {
  # Edit a single variable using validation rules and either meta mapping or explicit JSON path.
  local file meta_field env_var json_path label empty_action backup_job bool_toggle explicit_json_path
  file="$1"
  meta_field="$2"
  env_var="$3"
  label="$4"
  empty_action="${5:-cancel}"
  backup_job="${6-}"
  bool_toggle="${7:-false}"
  explicit_json_path="${8-}"

  if ! menu_spec_editor__block_if_env_locked "$env_var"; then
    return 0
  fi

  if [[ -n "$explicit_json_path" ]]; then
    json_path="$explicit_json_path"
  else
    json_path="$(validation_env_meta_field "$env_var" "$meta_field" 2>/dev/null || true)"
  fi
  if [[ -z "$json_path" ]]; then
    ui_warn "No config mapping for: $env_var"
    ui_pause
    return 0
  fi

  local rule type current v
  rule="$(validation_rule_json "$env_var" 2>/dev/null || true)"
  type="$(validation_env_type "$env_var" 2>/dev/null || echo "string")"
  [[ -z "$type" ]] && type="string"

  if jq -e '(.val_list|type) == "object"' <<<"$rule" >/dev/null 2>&1; then
    current="$(menu_spec_editor__json_get_csv_list "$file" "$json_path")"
    v="$(menu_spec_editor__prompt_value "$env_var" "$label" "$current" "clear_list" "false")"
    if [[ -z "$v" ]]; then
      if ! validation_check "$env_var" ""; then
        ui_warn "${VALIDATION_LAST_ERROR:-Empty is not allowed}"
        ui_pause
        return 0
      fi
      menu_spec_editor__session_backup_if_needed "$backup_job" || true
      if ! menu_spec_editor__set_path_with_jq "$file" "$json_path" --argjson val "[]"; then
        ui_pause
      fi
      return 0
    fi
    if ! validation_check "$env_var" "$v"; then
      ui_warn "${VALIDATION_LAST_ERROR:-Invalid value}"
      ui_pause
      return 0
    fi
    local list_json
    list_json="$(jq -cn --arg csv "$v" '$csv | split(",") | map(gsub("^\\s+|\\s+$";"")) | map(select(length>0))' 2>/dev/null || true)"
    if [[ -z "$list_json" ]]; then
      ui_warn "Cannot save: failed to convert list input"
      ui_pause
      return 0
    fi
    menu_spec_editor__session_backup_if_needed "$backup_job" || true
    if ! menu_spec_editor__set_path_with_jq "$file" "$json_path" --argjson val "$list_json"; then
      ui_pause
    fi
    return 0
  fi

  current="$(menu_spec_editor__json_get_scalar "$file" "$json_path")"

  if [[ "$type" == "bool" && "$bool_toggle" == "true" ]]; then
    [[ -z "$current" ]] && current="false"
  fi

  v="$(menu_spec_editor__prompt_value "$env_var" "$label" "$current" "$empty_action" "$bool_toggle")"
  if [[ -z "$v" ]]; then
    if [[ "$type" == "bool" && "$bool_toggle" == "true" ]]; then
      if [[ "$current" == "true" ]]; then
        v="false"
      else
        v="true"
      fi
    else
      if [[ "$empty_action" == "null" ]]; then
        if ! validation_check "$env_var" ""; then
          ui_warn "${VALIDATION_LAST_ERROR:-Empty is not allowed}"
          ui_pause
          return 0
        fi
        menu_spec_editor__session_backup_if_needed "$backup_job" || true
        if ! menu_spec_editor__set_path_with_jq "$file" "$json_path" --argjson val "null"; then
          ui_pause
        fi
      fi
      return 0
    fi
  fi

  if ! validation_check "$env_var" "$v"; then
    ui_warn "${VALIDATION_LAST_ERROR:-Invalid value}"
    ui_pause
    return 0
  fi

  local jq_arg
  case "$type" in
    bool|int|number) jq_arg="--argjson" ;;
    *) jq_arg="--arg" ;;
  esac

  menu_spec_editor__session_backup_if_needed "$backup_job" || true
  if ! menu_spec_editor__set_path_with_jq "$file" "$json_path" "$jq_arg" val "$v"; then
    ui_pause
  fi
}

