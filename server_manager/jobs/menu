  target="$1"
  mode="${2:-apply}"
  selector_env="$(menu_profile_selector_env_name "$target")"
  [[ -n "$selector_env" ]] || return 1
  if ! menu_env_override_is_set "$selector_env"; then
    return 1
  fi

  selector_value="$(menu_env_override_value "$selector_env")"
  ui_header "Profile Selection Locked by ENV"
  ui_warn "This profile flow is controlled by environment variables."
  if [[ -n "$selector_value" ]]; then
    ui_kv "ENV" "$selector_env=$(menu_env_override_pretty_value "$selector_env" "$selector_value") ${C_RED}[ENV]${C_RESET}"
  else
    ui_kv "ENV" "$selector_env=<set> ${C_RED}[ENV]${C_RESET}"
  fi
  ui_info "Action '${mode}' is disabled in menu while this ENV selector is set."
  ui_info "Remove it from docker-compose/container env and restart container to manage profiles in menu."
  ui_pause
  return 0
}

menu_profile_flow() {
  local target mode label config_file profiles_dir profile_count idx selected profile
  local -a profiles
  target="$1"
  mode="${2:-apply}"

  case "$target" in
    enshrouded)
      label="Enshrouded"
      config_file="$(enshrouded_config_path)"
      if [[ "$mode" == "apply" ]]; then
        profiles_dir="$EN_PROFILE_DIR"
        mapfile -t profiles < <(profiles_list_enshrouded | sort)
      else
        profile="$(enshrouded_profile_resolve)"
      fi
      ;;
    manager)
      label="Server Manager"
      config_file="$(manager_config_path)"
      if [[ "$mode" == "apply" ]]; then
        profiles_dir="$MANAGER_PROFILE_DIR"
        mapfile -t profiles < <(profiles_list_manager | sort)
      else
        profile="$(manager_profile_resolve)"
      fi
      ;;
    *)
      ui_fatal "Unknown profile target: $target"
      ;;
  esac

  if menu_profile_flow_blocked_by_env "$target" "$mode"; then
    return 0
  fi

  case "$mode" in
    apply)
      if ! menu_warn_env_overrides_before_profile_selection "$target"; then
        return 1
      fi

      profile_count="${#profiles[@]}"
      if [[ "$profile_count" -eq 0 ]]; then
        ui_error "No ${label} profiles found in: $profiles_dir"
        ui_pause
        return 1
      fi

      while :; do
        if menu_nav_is_set; then
          return 0
        fi
        ui_header "Select ${label} Profile"
        ui_kv "Profiles Folder" "$profiles_dir"
        echo
        idx=1
        for p in "${profiles[@]}"; do
          printf "%s[%s]%s %s%s%s\n" "${C_MAGENTA}" "$idx" "${C_RESET}" "${C_GREEN}" "$p" "${C_RESET}"
          idx=$((idx + 1))
        done
        echo
        ui_actions_bar "b Back" "m Main" "x Exit"
        echo

        selected="$(menu_prompt_nav_choice "Profile")"
        if menu_nav_choice_is_handled "$selected"; then
          return 0
        fi

        local selected_idx
        selected_idx="$(menu_choice_index "$selected" "$profile_count" || true)"
        if [[ -z "$selected_idx" ]]; then
          ui_warn "Invalid selection."
          ui_pause
          continue
        fi

        profile="${profiles[$selected_idx]}"

        if is_supervisor_running "server" || [[ -f "$config_file" ]]; then
          ui_warn "This will replace the active ${label} config with the selected profile."
          ui_warn "All players will be disconnected."
          echo
          ui_kv "Selected Profile" "$profile"
          ui_kv "Target File" "$(menu_display_path "$config_file")"
          echo
          if ! ui_confirm_yes_no "Stop server (if running) and apply this profile now?"; then
            ui_info "Cancelled."
            ui_pause
            continue
          fi
        fi

        if ! menu_run_profile_job "$target" "apply" "$profile"; then
          ui_warn "Failed to apply profile."
          menu_show_last_job_error
          ui_info "Check: server status"
          ui_pause
          continue
        fi

        ui_success "${label} profile applied: $profile"
        menu_profile_actions_after_change
        return 0
      done
      ;;

    reset)
      ui_header "Reset ${label} Profile"
      ui_warn "This resets $(basename "$config_file") from the currently selected profile."
      ui_warn "All players will be disconnected."
      echo
      ui_kv "Profile" "$profile"
      ui_kv "Target File" "$(menu_display_path "$config_file")"
      echo

      if ! ui_confirm_yes_no "Stop server (if running) and reset now?"; then
        ui_info "Cancelled."
        ui_pause
        return 0
      fi

      if ! menu_run_profile_job "$target" "reset" "$profile"; then
        ui_warn "Failed to reset profile."
        menu_show_last_job_error
        ui_info "Check: server status"
        ui_pause
        return 1
      fi

      ui_success "${label} profile reset completed: $profile"
      menu_profile_actions_after_change
      return 0
      ;;
    *)
      ui_fatal "Unknown profile mode: $mode"
      ;;
  esac
}

