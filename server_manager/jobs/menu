    return 0
  done
}

menu_restore_backup() {
  local backup_root save_dir selected choice file
  backup_root="$(backup_dir_resolve)"
  save_dir="$(menu_save_dir_resolve)"

  while :; do
    local -a files lines
    files=()
    mapfile -t lines < <(server_run backup list 2>/dev/null || true)
    for line in "${lines[@]}"; do
      [[ -n "$line" ]] || continue
      files+=("$line")
    done

    ui_header "Restore Backup"
    ui_kv "Backup Root" "$backup_root"
    ui_kv "Target Save Directory" "$save_dir"
    ui_kv "Savefile Name" "$savefile_name"
    echo

    if [[ "${#files[@]}" -eq 0 ]]; then
      ui_warn "No backup ZIP files found."
      echo
      if ui_confirm_yes_no "Create a manual backup now?"; then
        menu_run_savegame_backup || true
        continue
      fi
      return 0
    fi

    ui_info "Backups (newest first):"
    echo
    local idx base kind
    idx=1
    for file in "${files[@]}"; do
      base="$(basename "$file")"
      case "$file" in
        */scheduled/*) kind="scheduled" ;;
        *) kind="manual" ;;
      esac
      printf "%s[%s]%s %-11s %s\n" "${C_MAGENTA}" "$idx" "${C_RESET}" "${kind}" "$base"
      idx=$((idx + 1))
    done
    echo
    ui_actions_bar "b Back" "m Main" "x Exit"
    echo

    choice="$(menu_prompt_nav_choice "Backup")"
    if menu_nav_choice_is_handled "$choice"; then
      return 0
    fi

    local selected_idx
    selected_idx="$(menu_choice_index "$choice" "${#files[@]}" || true)"
    if [[ -z "$selected_idx" ]]; then
      ui_warn "Invalid selection."
      ui_pause
      continue
    fi

    selected="${files[$selected_idx]}"

    local has_savegame has_enshrouded has_manager inspect_raw
    inspect_raw="$(
      BACKUP_INSPECT_FORMAT=raw server_run backup inspect "$selected" 2>/dev/null \
        | awk '/^(true|false) (true|false) (true|false)$/{line=$0} END{print line}'
    )"
    read -r has_savegame has_enshrouded has_manager <<<"$inspect_raw"
    [[ "$has_savegame" == "true" || "$has_savegame" == "false" ]] || has_savegame="false"
    [[ "$has_enshrouded" == "true" || "$has_enshrouded" == "false" ]] || has_enshrouded="false"
    [[ "$has_manager" == "true" || "$has_manager" == "false" ]] || has_manager="false"
    if [[ "$has_savegame" != "true" && "$has_enshrouded" != "true" && "$has_manager" != "true" ]]; then
      ui_warn "No restorable components detected in this backup."
      ui_pause
      continue
    fi

    ui_header "Restore Backup"
    ui_warn "WARNING: Selected components will overwrite current data."
    ui_warn "The server will be stopped and players disconnected."
    echo
    ui_kv "Selected Backup" "$(basename "$selected")"
    ui_kv "Detected Components" "savegame=$has_savegame, enshrouded=$has_enshrouded, manager=$has_manager"
    echo

    if ! ui_confirm_yes_no "Continue to component selection?"; then
      ui_info "Cancelled."
      ui_pause
      continue
    fi

    local restore_savegame restore_enshrouded restore_manager safety
    restore_savegame="false"
    restore_enshrouded="false"
    restore_manager="false"
    safety="false"

    if [[ "$has_savegame" == "true" ]] && ui_confirm_yes_no "Restore savegame files?"; then
      restore_savegame="true"
    fi
    if [[ "$has_enshrouded" == "true" ]] && ui_confirm_yes_no "Restore enshrouded_server.json?"; then
      restore_enshrouded="true"
    fi
    if [[ "$has_manager" == "true" ]] && ui_confirm_yes_no "Restore server_manager.json?"; then
      restore_manager="true"
    fi

    if [[ "$restore_savegame" != "true" && "$restore_enshrouded" != "true" && "$restore_manager" != "true" ]]; then
      ui_warn "Nothing selected for restore."
      ui_pause
      continue
    fi

    if ui_confirm_yes_no "Create safety backup before restore?"; then
      safety="true"
    fi

    local restore_selector
    local -a restore_parts restore_cmd
    restore_parts=()
    [[ "$restore_savegame" == "true" ]] && restore_parts+=("savegame")
    [[ "$restore_enshrouded" == "true" ]] && restore_parts+=("enshrouded")
    [[ "$restore_manager" == "true" ]] && restore_parts+=("manager")
    restore_selector="$(IFS=,; echo "${restore_parts[*]}")"

    restore_cmd=(backup restore "$selected" "$restore_selector" --safety-backup "$safety")

    if ! server_run "${restore_cmd[@]}" >/dev/null 2>&1; then
      ui_error "Restore command failed."
      ui_pause
      continue
    fi

    ui_success "Restore finished."
    echo
    menu_prompt_start_server "Start server now?"
    ui_pause
    return 0
  done
}

menu_spec_ready() {
