#!/usr/bin/env bash

SCRIPT_DIR="$(cd -P "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" >/dev/null 2>&1 && pwd)"
MANAGER_ROOT="$(cd -P "${SCRIPT_DIR}/.." >/dev/null 2>&1 && pwd)"
# shellcheck source=server_manager/lib/log
. "${SCRIPT_DIR}/../lib/log"

MENU_CONFIG_FILE="${MENU_CONFIG_FILE:-${MANAGER_ROOT}/profiles/menu/menu.json}"
MENU_UI_SCRIPT="${MENU_UI_SCRIPT:-${MANAGER_ROOT}/ui/menu_ui}"
STARTUP_BANNER_SCRIPT="${STARTUP_BANNER_SCRIPT:-${MANAGER_ROOT}/ui/startup_banner}"

MENU_START_SCREEN="${MENU_START_SCREEN:-}"
MENU_ONCE="${MENU_ONCE:-false}"
MENU_NO_CLEAR="${MENU_NO_CLEAR:-false}"

usage() {
  cat <<'EOF'
Usage:
  menu

Configuration via ENV:
  MENU_CONFIG_FILE=<path_to_menu.json>
  MENU_START_SCREEN=<screen_id>
  MENU_ONCE=true|false
  MENU_NO_CLEAR=true|false
EOF
}

require_file() {
  local file
  file="$1"
  [[ -f "$file" ]] || fatal "Required file not found: $file"
}

require_executable() {
  local file
  file="$1"
  [[ -x "$file" ]] || fatal "Command is not executable: $file"
}

require_command() {
  local command_name
  command_name="$1"
  command -v "$command_name" >/dev/null 2>&1 || fatal "Required command not found: $command_name"
}

menu_config_query() {
  jq "$@" "$MENU_CONFIG_FILE"
}

menu_screen_exists() {
  local screen_id
  screen_id="$1"
  menu_config_query -e --arg screen "$screen_id" '.menus[] | select(.id == $screen)' >/dev/null
}

menu_lookup_option() {
  local screen_id option_key
  screen_id="$1"
  option_key="$2"

  menu_config_query -c --arg screen "$screen_id" --arg option "$option_key" \
    '[(.menus[] | select(.id == $screen) | .options[] | select(.key == $option))][0] // empty'
}

menu_validate_config() {
  local duplicate_screens missing_action_refs missing_screen_refs

  menu_config_query -e '
    type == "object"
    and (.menus | type == "array")
    and (.menus | length > 0)
    and (.actions | type == "object")
  ' >/dev/null || fatal "Invalid menu configuration schema: $MENU_CONFIG_FILE"

  duplicate_screens="$(menu_config_query -r '[.menus[].id] | group_by(.)[] | select(length > 1) | .[0]')"
  if [[ -n "$duplicate_screens" ]]; then
    fatal "Duplicate menu screen ids in menu config: ${duplicate_screens}"
  fi

  missing_action_refs="$(menu_config_query -r '
    . as $root
    | [
        .menus[] as $menu
        | $menu.options[]
        | select((.type // "action") == "action")
        | select(((.action // "") | length) == 0 or ($root.actions[.action] // null) == null)
        | "\($menu.id):\(.key)"
      ]
    | .[]?
  ')"
  if [[ -n "$missing_action_refs" ]]; then
    fatal "Menu option(s) reference missing actions: ${missing_action_refs}"
  fi

  missing_screen_refs="$(menu_config_query -r '
    . as $root
    | [
        .menus[] as $menu
        | $menu.options[]
        | select((.type // "action") == "screen")
        | .next as $next
        | select(($next | type) != "string" or ($next | length) == 0 or ([ $root.menus[].id ] | index($next)) == null)
        | "\($menu.id):\(.key)"
      ]
    | .[]?
  ')"
  if [[ -n "$missing_screen_refs" ]]; then
    fatal "Menu option(s) reference missing target screens: ${missing_screen_refs}"
  fi
}

menu_read_start_screen() {
  local screen_id
  if [[ -n "$MENU_START_SCREEN" ]]; then
    screen_id="$MENU_START_SCREEN"
  else
    screen_id="$(menu_config_query -r '.start_screen // .menus[0].id')"
  fi

  [[ -n "$screen_id" ]] || fatal "Unable to resolve menu start screen"
  menu_screen_exists "$screen_id" || fatal "Menu start screen not found: $screen_id"
  printf "%s" "$screen_id"
}

menu_render_screen() {
  local screen_id title subtitle
  screen_id="$1"
  title="$(menu_config_query -r --arg screen "$screen_id" '.menus[] | select(.id == $screen) | (.title // .id)')"
  subtitle="$(menu_config_query -r --arg screen "$screen_id" '.menus[] | select(.id == $screen) | (.subtitle // empty)')"

  ui_clear_screen
  bash "$STARTUP_BANNER_SCRIPT"
  ui_print_title "$title"
  if [[ -n "$subtitle" ]]; then
    ui_print_subtitle "$subtitle"
  else
    printf "\n"
  fi

  while IFS=$'\t' read -r option_key option_label; do
    [[ -n "$option_key" ]] || continue
    ui_print_option "$option_key" "$option_label"
  done < <(
    menu_config_query -r --arg screen "$screen_id" \
      '.menus[] | select(.id == $screen) | .options[] | [ .key, (.label // .key) ] | @tsv'
  )
  printf "\n"
}

menu_read_prompt() {
  local screen_id
  screen_id="$1"
  menu_config_query -r --arg screen "$screen_id" \
    '.menus[] | select(.id == $screen) | (.prompt // "Select option")'
}

menu_run_action() {
  local action_id action_json confirm_text command_path resolved_command rc
  local -a command_args action_env
  action_id="$1"

  action_json="$(menu_config_query -c --arg action "$action_id" '.actions[$action] // empty')"
  [[ -n "$action_json" ]] || fatal "Menu action is not configured: $action_id"

  confirm_text="$(jq -r '.confirm // empty' <<<"$action_json")"
  if [[ -n "$confirm_text" ]] && ! ui_confirm "$confirm_text" "false"; then
    ui_warn "Action cancelled: ${action_id}"
    return 0
  fi

  command_path="$(jq -r '.command // empty' <<<"$action_json")"
  [[ -n "$command_path" ]] || fatal "Menu action has no command: $action_id"

  if [[ "$command_path" = /* ]]; then
    resolved_command="$command_path"
  else
    resolved_command="${MANAGER_ROOT}/${command_path}"
  fi
  require_executable "$resolved_command"

  mapfile -t command_args < <(jq -r '.args[]? // empty' <<<"$action_json")
  mapfile -t action_env < <(jq -r '.env // {} | to_entries[] | "\(.key)=\(.value | tostring)"' <<<"$action_json")

  ui_info "Executing action: ${action_id}"
  if [[ "${#action_env[@]}" -gt 0 ]]; then
    env "${action_env[@]}" "$resolved_command" "${command_args[@]}"
  else
    "$resolved_command" "${command_args[@]}"
  fi
  rc=$?

  if [[ "$rc" -eq 0 ]]; then
    ui_info "Action completed: ${action_id}"
  else
    ui_error "Action failed: ${action_id} (rc=${rc})"
  fi
  return "$rc"
}

menu_loop() {
  local current_screen option_key option_json option_type next_screen action_id prompt_text rc
  current_screen="$(menu_read_start_screen)"

  while true; do
    menu_render_screen "$current_screen"
    prompt_text="$(menu_read_prompt "$current_screen")"

    ui_prompt_input option_key "$prompt_text" ""
    option_key="$(echo "${option_key}" | tr -d '\r' | xargs)"
    if [[ -z "$option_key" ]]; then
      if [[ -t 0 ]]; then
        ui_warn "No menu option selected."
        ui_pause
        continue
      fi
      ui_error "No menu input available on stdin."
      return 1
    fi

    option_json="$(menu_lookup_option "$current_screen" "$option_key")"
    if [[ -z "$option_json" ]]; then
      ui_warn "Unknown menu option: ${option_key}"
      if [[ -t 0 ]]; then
        ui_pause
        continue
      fi
      return 1
    fi

    option_type="$(jq -r '.type // "action"' <<<"$option_json")"
    case "$option_type" in
      action)
        action_id="$(jq -r '.action // empty' <<<"$option_json")"
        if [[ -z "$action_id" ]]; then
          ui_error "Menu action option has no action id (screen=${current_screen}, option=${option_key})"
          rc=1
        else
          menu_run_action "$action_id"
          rc=$?
        fi
        if [[ "$MENU_ONCE" == "true" ]]; then
          return "$rc"
        fi
        ui_pause
        ;;
      screen)
        next_screen="$(jq -r '.next // empty' <<<"$option_json")"
        if [[ -z "$next_screen" ]]; then
          ui_error "Menu screen option has no next screen (screen=${current_screen}, option=${option_key})"
          rc=1
          if [[ "$MENU_ONCE" == "true" ]]; then
            return "$rc"
          fi
          ui_pause
          continue
        fi
        if ! menu_screen_exists "$next_screen"; then
          ui_error "Menu target screen not found: ${next_screen}"
          rc=1
          if [[ "$MENU_ONCE" == "true" ]]; then
            return "$rc"
          fi
          ui_pause
          continue
        fi
        current_screen="$next_screen"
        ;;
      exit)
        ui_info "Leaving menu."
        return 0
        ;;
      *)
        ui_error "Unsupported menu option type: ${option_type}"
        rc=1
        if [[ "$MENU_ONCE" == "true" ]]; then
          return "$rc"
        fi
        ui_pause
        ;;
    esac
  done
}

main() {
  case "${1-}" in
    --help|-h|help)
      usage
      exit 0
      ;;
    "")
      ;;
    *)
      fatal "menu job does not accept arguments"
      ;;
  esac

  require_file "$MENU_CONFIG_FILE"
  require_command jq
  require_file "$MENU_UI_SCRIPT"
  require_file "$STARTUP_BANNER_SCRIPT"

  # shellcheck disable=SC1090
  . "$MENU_UI_SCRIPT"

  menu_validate_config
  info "Running menu job orchestrator"
  menu_loop
}

main "$@"
