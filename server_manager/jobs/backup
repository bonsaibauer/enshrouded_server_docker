#!/usr/bin/env bash

SCRIPT_DIR="$(cd -P "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" >/dev/null 2>&1 && pwd)"
# shellcheck source=server_manager/lib/log
. "${SCRIPT_DIR}/../lib/log"

COMMAND_ROOT="${COMMAND_ROOT:-${SCRIPT_DIR}/../commands}"
BACKUP_EXEC_MODE="${BACKUP_EXEC_MODE:-scheduled}"
BACKUP_ZIP_VALUE="${BACKUP_ZIP:-}"
BACKUP_SAFETY_BACKUP_VALUE="${BACKUP_SAFETY_BACKUP:-}"

usage() {
  cat <<'EOF'
Usage:
  backup

Configuration via ENV:
  BACKUP_EXEC_MODE=
    scheduled|scheduled-all|scheduled-config|
    manual|manual-all|manual-config|
    restore-all|restore-config|restore-savegame|restore-enshrouded|restore-manager|
    check-list|check-inspect
  BACKUP_ZIP=<zip_path_or_name>                 (required for restore-* and check-inspect)
  BACKUP_SAFETY_BACKUP=true|false               (optional for restore-*)
EOF
}

require_executable() {
  local file
  file="$1"
  [[ -x "$file" ]] || fatal "Command is not executable: $file"
}

run_restore_command() {
  local command
  command="$1"
  [[ -n "$BACKUP_ZIP_VALUE" ]] || fatal "BACKUP_ZIP is required for restore mode"
  require_executable "$command"
  if [[ -n "$BACKUP_SAFETY_BACKUP_VALUE" ]]; then
    "$command" --zip "$BACKUP_ZIP_VALUE" --safety-backup "$BACKUP_SAFETY_BACKUP_VALUE"
  else
    "$command" --zip "$BACKUP_ZIP_VALUE"
  fi
}

main() {
  local command

  case "${1-}" in
    --help|-h|help)
      usage
      exit 0
      ;;
    "")
      ;;
    *)
      fatal "backup job does not accept arguments"
      ;;
  esac

  info "Running backup job dispatcher (mode=${BACKUP_EXEC_MODE})"

  case "$BACKUP_EXEC_MODE" in
    scheduled|"")
      command="${COMMAND_ROOT}/scheduled/scheduled-backup"
      require_executable "$command"
      "$command"
      ;;
    scheduled-all)
      command="${COMMAND_ROOT}/scheduled/scheduled-backup-all"
      require_executable "$command"
      "$command"
      ;;
    scheduled-config)
      command="${COMMAND_ROOT}/scheduled/scheduled-backup-config"
      require_executable "$command"
      "$command"
      ;;
    manual)
      command="${COMMAND_ROOT}/manual/backup"
      require_executable "$command"
      "$command"
      ;;
    manual-all)
      command="${COMMAND_ROOT}/manual/backup-all"
      require_executable "$command"
      "$command"
      ;;
    manual-config)
      command="${COMMAND_ROOT}/manual/backup-config"
      require_executable "$command"
      "$command"
      ;;
    restore-all)
      run_restore_command "${COMMAND_ROOT}/restore/restore-backup-all"
      ;;
    restore-config)
      run_restore_command "${COMMAND_ROOT}/restore/restore-backup-config"
      ;;
    restore-savegame)
      run_restore_command "${COMMAND_ROOT}/restore/restore-backup-savegame"
      ;;
    restore-enshrouded)
      run_restore_command "${COMMAND_ROOT}/restore/restore-backup-enshrouded"
      ;;
    restore-manager)
      run_restore_command "${COMMAND_ROOT}/restore/restore-backup-manager"
      ;;
    check-list)
      command="${COMMAND_ROOT}/check/check-backup-list"
      require_executable "$command"
      "$command"
      ;;
    check-inspect)
      [[ -n "$BACKUP_ZIP_VALUE" ]] || fatal "BACKUP_ZIP is required for BACKUP_EXEC_MODE=check-inspect"
      command="${COMMAND_ROOT}/check/check-backup-inspect"
      require_executable "$command"
      "$command" --zip "$BACKUP_ZIP_VALUE"
      ;;
    *)
      fatal "Invalid BACKUP_EXEC_MODE: $BACKUP_EXEC_MODE"
      ;;
  esac
}

main "$@"
