#!/usr/bin/env bash

SCRIPT_DIR="$(cd -P "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" >/dev/null 2>&1 && pwd)"
# shellcheck source=server_manager/lib/log
. "${SCRIPT_DIR}/../lib/log"

COMMAND_ROOT="${COMMAND_ROOT:-${SCRIPT_DIR}/../commands}"
PROFILE_EXEC_ACTION="${PROFILE_EXEC_ACTION:-check-password}"
PROFILE_NAME_VALUE="${PROFILE_NAME:-}"
PROFILE_CREATE_BACKUP_VALUE="${PROFILE_CREATE_BACKUP:-}"

usage() {
  cat <<'EOF'
Usage:
  profile

Configuration via ENV:
  PROFILE_EXEC_ACTION=
    check-password|
    apply-manager|apply-enshrouded|
    reset-manager|reset-enshrouded
  PROFILE_NAME=<profile_name>                  (required for apply-*)
  PROFILE_CREATE_BACKUP=true|false             (optional for apply-* and reset-*)
EOF
}

require_executable() {
  local file
  file="$1"
  [[ -x "$file" ]] || fatal "Command is not executable: $file"
}

main() {
  local command

  case "${1-}" in
    --help|-h|help)
      usage
      exit 0
      ;;
    "")
      ;;
    *)
      fatal "profile job does not accept arguments"
      ;;
  esac

  info "Running profile job dispatcher (action=${PROFILE_EXEC_ACTION})"

  case "$PROFILE_EXEC_ACTION" in
    check-password|"")
      command="${COMMAND_ROOT}/check/check-password"
      require_executable "$command"
      "$command"
      ;;
    apply-manager)
      [[ -n "$PROFILE_NAME_VALUE" ]] || fatal "PROFILE_NAME is required for PROFILE_EXEC_ACTION=apply-manager"
      command="${COMMAND_ROOT}/manual/apply-profile-manager"
      require_executable "$command"
      if [[ -n "$PROFILE_CREATE_BACKUP_VALUE" ]]; then
        "$command" --profile "$PROFILE_NAME_VALUE" --create-backup "$PROFILE_CREATE_BACKUP_VALUE"
      else
        "$command" --profile "$PROFILE_NAME_VALUE"
      fi
      ;;
    apply-enshrouded)
      [[ -n "$PROFILE_NAME_VALUE" ]] || fatal "PROFILE_NAME is required for PROFILE_EXEC_ACTION=apply-enshrouded"
      command="${COMMAND_ROOT}/manual/apply-profile-enshrouded"
      require_executable "$command"
      if [[ -n "$PROFILE_CREATE_BACKUP_VALUE" ]]; then
        "$command" --profile "$PROFILE_NAME_VALUE" --create-backup "$PROFILE_CREATE_BACKUP_VALUE"
      else
        "$command" --profile "$PROFILE_NAME_VALUE"
      fi
      ;;
    reset-manager)
      command="${COMMAND_ROOT}/restore/reset-profile-manager"
      require_executable "$command"
      if [[ -n "$PROFILE_CREATE_BACKUP_VALUE" ]]; then
        "$command" --create-backup "$PROFILE_CREATE_BACKUP_VALUE"
      else
        "$command"
      fi
      ;;
    reset-enshrouded)
      command="${COMMAND_ROOT}/restore/reset-profile-enshrouded"
      require_executable "$command"
      if [[ -n "$PROFILE_CREATE_BACKUP_VALUE" ]]; then
        "$command" --create-backup "$PROFILE_CREATE_BACKUP_VALUE"
      else
        "$command"
      fi
      ;;
    *)
      fatal "Invalid PROFILE_EXEC_ACTION: $PROFILE_EXEC_ACTION"
      ;;
  esac
}

main "$@"
