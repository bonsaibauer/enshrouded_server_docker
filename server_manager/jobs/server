#!/bin/bash
SCRIPT_DIR="$(cd -P "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" >/dev/null 2>&1 && pwd)"
# shellcheck source=server_manager/jobs/env-validation
. "${SCRIPT_DIR}/env-validation"

SUPERVISORCTL_BIN="${SUPERVISORCTL_BIN:-supervisorctl}"

enshrouded_server_pid=-1
timeout=60
kill_signal=INT
WAIT_FOR_DOWNLOAD="true"
enshrouded_server=""
SERVER_ACTION="run"
CHECK_PLAYERS="true"
SERVER_QUERY_PORT=""

STARTUP_UI_WAIT_TIMEOUT="${SUPERVISOR_STARTUP_WAIT_TIMEOUT:-180}"
STARTUP_UI_WAIT_INTERVAL="${SUPERVISOR_STARTUP_WAIT_INTERVAL:-1}"
SERVER_GUARD_BACKOFFS=("1" "2" "4" "8")
SERVER_GUARD_LAST_REASON=""
SERVER_GUARD_RC_NOT_READY=10
SERVER_GUARD_RC_CONFIG=20
SERVER_GUARD_RC_INTERNAL=30

usage_server() {
  cat <<'EOF'
Usage:
  server [--wait-download|--no-wait-download]
  server --stop-safe [--shutdown-timeout <seconds>]
  server --players-check [--player-check|--no-player-check] [--query-port <port>]
  server --render-banner
  server --startup-ui
EOF
}

usage_hook_run() {
  cat <<'EOF'
Usage:
  hook-run <name> [command...]
  hook-run --name <name> [--command <command>]
EOF
}

usage_commands() {
  cat <<'EOF'
Usage:
  docker exec CONTAINER_NAME server <command> [args...]

Commands:
  hook-run       Execute hook (simple: hook-run <name> [command...])
  guard-run      Internal: run a guarded call (server_guard_run API)
  guard-require  Internal: run guard, fail hard when blocked
  status         Show supervisor program status
  menu           Start interactive Server Manager menu
  start          Start server
  stop           Stop server
  restart        Restart server (simple: restart | restart force | restart player-check | restart no-player-check)
  update         Trigger updater (simple: update | update force | update check | update player-check | update no-player-check)
  scheduled-backup
                 Trigger backup job via supervisor
  backup         Trigger backup job (simple: backup | backup list | backup inspect <zip> | backup restore <zip> [target])
  profile        Trigger profile job (simple: profile <manager|enshrouded> <apply|reset> [profile] | profile passwords [text|json])
  password-view  Show user group rights and passwords from enshrouded_server.json (simple: password-view [text|json])
  env-validation Run ENV validation job
  scheduled-restart
                 Trigger restart job
  bootstrap      Trigger bootstrap (simple: bootstrap | bootstrap job | bootstrap no-update | bootstrap entrypoint)
  cron           Manage cron (simple: cron sync | cron start|stop|restart|status)
  help           Show this help
EOF
}

is_server_command() {
  case "$1" in
    hook-run|guard-run|guard-require|status|menu|start|stop|restart|update|scheduled-backup|backup|backup-config|profile|password-view|env-validation|scheduled-restart|bootstrap|cron|help|--help|-h)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

run_supervisorctl() {
  "$SUPERVISORCTL_BIN" "$@"
}

is_supervisorctl_idempotent_notice() {
  local action output
  action="$1"
  output="$2"
  case "$action" in
    start)
      [[ "$output" == *"ERROR (already started)"* ]]
      ;;
    stop)
      [[ "$output" == *"ERROR (not running)"* ]]
      ;;
    *)
      return 1
      ;;
  esac
}

run_supervisorctl_program_action() {
  local action program output rc
  action="$1"
  program="$2"

  output="$(run_supervisorctl "$action" "$program" 2>&1)"
  rc=$?

  if is_supervisorctl_idempotent_notice "$action" "$output"; then
    case "$action" in
      start)
        info "${program}: already running"
        ;;
      stop)
        info "${program}: already stopped"
        ;;
    esac
    return 0
  fi

  if [[ -n "$output" ]]; then
    if [[ "$rc" -eq 0 ]]; then
      printf "%s\n" "$output"
    else
      printf "%s\n" "$output" >&2
    fi
  fi

  return "$rc"
}

status_output_prepare_colors() {
  local log_color_value
  log_color_value="$(resolve_from_env_or_manager "LOG_COLOR" ".logColor" "true")"
  if [[ "$log_color_value" == "true" || "$log_color_value" == "TRUE" ]]; then
    C_RESET=$'\033[0m'
    C_DIM=$'\033[2m'
    C_RED=$'\033[31m'
    C_YELLOW=$'\033[33m'
    C_GREEN=$'\033[32m'
    C_MAGENTA=$'\033[35m'
  else
    init_colors
  fi
}

status_state_color() {
  case "$1" in
    RUNNING)
      printf "%s" "$C_GREEN"
      ;;
    STARTING|STOPPING|EXITED)
      printf "%s" "$C_YELLOW"
      ;;
    STOPPED|FATAL|BACKOFF|UNKNOWN)
      printf "%s" "$C_RED"
      ;;
    *)
      printf "%s" "$C_MAGENTA"
      ;;
  esac
}

render_colored_supervisor_status() {
  local output rc line program state details color
  output="$(run_supervisorctl status 2>&1)"
  rc=$?
  # supervisorctl returns rc=3 when one or more programs are not RUNNING.
  # For a status view this is expected and should still be rendered normally.
  if [[ "$rc" -ne 0 && "$rc" -ne 3 ]]; then
    printf "%s\n" "$output" >&2
    return "$rc"
  fi

  status_output_prepare_colors
  while IFS= read -r line; do
    if [[ "$line" =~ ^([^[:space:]]+)[[:space:]]+([^[:space:]]+)([[:space:]].*)?$ ]]; then
      program="${BASH_REMATCH[1]}"
      state="${BASH_REMATCH[2]}"
      details="${BASH_REMATCH[3]-}"
      color="$(status_state_color "$state")"
      printf "%s%-16s%s %s%s%s%s\n" \
        "${C_DIM}" "$program" "${C_RESET}" \
        "${color}" "$state" "${C_RESET}" \
        "${details}"
    else
      printf "%s\n" "$line"
    fi
  done <<<"$output"

  return 0
}

debug() { [[ "${LOG_LEVEL:-40}" -ge 50 ]] && echo "DEBUG - $*" || true; }

checkRunning() {
  is_supervisor_running "$1"
}

checkLock() {
  local pidfile pid
  pidfile="$1"
  [[ -n "$pidfile" ]] || return 0
  [[ -f "$pidfile" ]] || return 0
  pid="$(cat "$pidfile" 2>/dev/null || true)"
  if [[ -n "$pid" ]] && [[ "$pid" =~ ^[0-9]+$ ]] && [[ -d "/proc/$pid" ]]; then
    fatal "Lock active: $pidfile (pid=$pid)"
  fi
  rm -f "$pidfile" 2>/dev/null || true
  return 0
}

clearLock() {
  local pidfile
  pidfile="$1"
  [[ -n "$pidfile" ]] || return 0
  rm -f "$pidfile" 2>/dev/null || true
  return 0
}

server_guard_set_reason() {
  SERVER_GUARD_LAST_REASON="$1"
}

server_guard_classify_reason() {
  local reason
  reason="${1:-unknown}"
  case "$reason" in
    supervisor_unreachable|server_not_running:*)
      echo "not_ready"
      ;;
    missing_tool:*|missing_var:*|missing_function:*|invalid_guard_mode:*)
      echo "config_error"
      ;;
    *)
      echo "internal_error"
      ;;
  esac
}

server_guard_rc_for_class() {
  case "$1" in
    not_ready) echo "$SERVER_GUARD_RC_NOT_READY" ;;
    config_error) echo "$SERVER_GUARD_RC_CONFIG" ;;
    *) echo "$SERVER_GUARD_RC_INTERNAL" ;;
  esac
}

server_guard_check_core_ready() {
  local fn
  server_guard_set_reason ""

  command -v "$SUPERVISORCTL_BIN" >/dev/null 2>&1 || {
    server_guard_set_reason "missing_tool:${SUPERVISORCTL_BIN}"
    return 1
  }
  command -v jq >/dev/null 2>&1 || {
    server_guard_set_reason "missing_tool:jq"
    return 1
  }
  command -v python3 >/dev/null 2>&1 || {
    server_guard_set_reason "missing_tool:python3"
    return 1
  }
  run_supervisorctl pid >/dev/null 2>&1 || {
    server_guard_set_reason "supervisor_unreachable"
    return 1
  }
  [[ -n "${SCRIPT_DIR:-}" ]] || {
    server_guard_set_reason "missing_var:SCRIPT_DIR"
    return 1
  }
  [[ -n "${install_path:-}" ]] || {
    server_guard_set_reason "missing_var:install_path"
    return 1
  }

  for fn in info warn fatal run_supervisorctl; do
    declare -F "$fn" >/dev/null 2>&1 || {
      server_guard_set_reason "missing_function:${fn}"
      return 1
    }
  done

  return 0
}

server_guard_check_server_ready() {
  local state
  server_guard_check_core_ready || return 1
  state="$(startup_ui_state "server")"
  if [[ "$state" != "RUNNING" ]]; then
    server_guard_set_reason "server_not_running:${state:-unknown}"
    return 1
  fi
  return 0
}

server_guard_check_job_ready() {
  local job
  job="$1"
  server_guard_check_core_ready || return 1

  case "$job" in
    updater)
      [[ -n "${steamcmd_path:-}" ]] || {
        server_guard_set_reason "missing_var:steamcmd_path"
        return 1
      }
      ;;
  esac

  return 0
}

server_guard_check_mode() {
  local mode job
  mode="$1"

  case "$mode" in
    core_ready)
      server_guard_check_core_ready
      ;;
    server_ready)
      server_guard_check_server_ready
      ;;
    job_ready:*)
      job="${mode#job_ready:}"
      server_guard_check_job_ready "$job"
      ;;
    *)
      server_guard_set_reason "invalid_guard_mode:${mode}"
      return 1
      ;;
  esac
}

server_guard_run() {
  local mode wait reason class rc
  local -a cmd
  mode="${1-}"
  shift || true

  [[ -n "$mode" ]] || fatal "server_guard_run requires <guard_mode>"
  [[ "${1-}" == "--" ]] || fatal "server_guard_run usage: server_guard_run <guard_mode> -- <call...>"
  shift || true
  [[ "$#" -gt 0 ]] || fatal "server_guard_run requires a command after --"
  cmd=("$@")

  if server_guard_check_mode "$mode"; then
    "${cmd[@]}"
    return $?
  fi

  for wait in "${SERVER_GUARD_BACKOFFS[@]}"; do
    sleep "$wait"
    if server_guard_check_mode "$mode"; then
      "${cmd[@]}"
      return $?
    fi
  done

  reason="${SERVER_GUARD_LAST_REASON:-unknown}"
  class="$(server_guard_classify_reason "$reason")"
  rc="$(server_guard_rc_for_class "$class")"
  warn "GUARD_BLOCK mode=$mode reason=$reason class=$class rc=$rc"
  return "$rc"
}

server_guard_require() {
  local mode rc
  mode="${1-}"
  server_guard_run "$@"
  rc=$?
  if [[ "$rc" -ne 0 ]]; then
    fatal "GUARD_FAIL mode=${mode:-unknown} reason=${SERVER_GUARD_LAST_REASON:-unknown} rc=$rc"
  fi
  return 0
}

run_job_script() {
  local script guard_mode
  script="$1"
  shift || true
  guard_mode="core_ready"
  if [[ "$script" == "updater" ]]; then
    guard_mode="job_ready:updater"
  fi
  server_guard_run "$guard_mode" -- run_as_enshrouded_if_root "${SCRIPT_DIR}/${script}" "$@"
}

run_job_or_supervisor_start() {
  local script program guard_mode
  script="$1"
  program="$2"
  shift 2
  guard_mode="core_ready"
  if [[ "$script" == "updater" || "$program" == "updater" ]]; then
    guard_mode="job_ready:updater"
  elif [[ "$script" == "restart" && "$program" == "restart" ]]; then
    guard_mode="server_ready"
  fi
  if [[ "$#" -gt 0 ]]; then
    server_guard_run "$guard_mode" -- run_as_enshrouded_if_root "${SCRIPT_DIR}/${script}" "$@"
  else
    server_guard_run "$guard_mode" -- run_supervisorctl_program_action start "$program"
  fi
}

require_no_args() {
  local cmd_name
  cmd_name="$1"
  shift || true
  if [[ "$#" -gt 0 ]]; then
    echo "$cmd_name does not accept arguments" >&2
    exit 1
  fi
}

run_as_enshrouded_if_root() {
  if [[ "$(id -u)" -ne 0 ]]; then
    "$@"
    return $?
  fi

  if command -v runuser >/dev/null 2>&1; then
    # Preserve container/runtime env (e.g. INSTALL_PATH, profile dirs, hooks),
    # but force identity-related vars for the target user.
    if runuser --help 2>&1 | grep -q -- '--preserve-environment'; then
      runuser -u enshrouded --preserve-environment -- env \
        HOME="/home/enshrouded" \
        USER="enshrouded" \
        LOGNAME="enshrouded" \
        "$@"
    else
      runuser -u enshrouded -- env \
        HOME="/home/enshrouded" \
        USER="enshrouded" \
        LOGNAME="enshrouded" \
        "$@"
    fi
    return $?
  fi

  if command -v su >/dev/null 2>&1; then
    local cmd_quoted
    printf -v cmd_quoted '%q ' "$@"
    # -m keeps environment similar to runuser --preserve-environment.
    su -m -s /bin/bash enshrouded -c "$cmd_quoted"
    return $?
  fi

  fatal "Cannot drop root privileges: neither runuser nor su is available"
}

is_non_flag_token() {
  [[ $# -gt 0 && -n "$1" && "${1#-}" == "$1" ]]
}

run_hook() {
  local hook_name hook_cmd
  hook_name="$1"
  hook_cmd="$2"
  if [[ -z "$hook_cmd" ]]; then
    return 0
  fi
  echo "INFO - Running ${hook_name} hook: $hook_cmd"
  eval "$hook_cmd"
}

run_hook_command() {
  local hook_name hook_cmd
  hook_name=""
  hook_cmd=""
  if [[ "$#" -gt 0 ]] && is_non_flag_token "$1"; then
    if [[ "$1" == "help" && "$#" -eq 1 ]]; then
      usage_hook_run
      return 0
    fi
    hook_name="$1"
    shift
    if [[ "$#" -gt 0 ]]; then
      hook_cmd="$*"
    fi
    run_hook "$hook_name" "$hook_cmd"
    return 0
  fi
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)
        hook_name="${2-}"
        [[ -n "$hook_name" ]] || {
          echo "Missing value for --name" >&2
          exit 1
        }
        shift 2
        ;;
      --command)
        hook_cmd="${2-}"
        shift 2
        ;;
      --help|-h)
        usage_hook_run
        exit 0
        ;;
      *)
        echo "Unknown argument for hook-run: $1" >&2
        usage_hook_run >&2
        exit 1
        ;;
    esac
  done
  [[ -n "$hook_name" ]] || {
    echo "Missing hook name (usage: hook-run <name> [command...])" >&2
    exit 1
  }
  run_hook "$hook_name" "$hook_cmd"
}

load_server_command_hooks() {
  SERVER_COMMAND_PRE_HOOK="$(resolve_from_env_or_manager "SERVER_COMMAND_PRE_HOOK" ".serverCommandPreHook" "")"
  SERVER_COMMAND_POST_HOOK="$(resolve_from_env_or_manager "SERVER_COMMAND_POST_HOOK" ".serverCommandPostHook" "")"
}

run_server_command() {
  local command_name
  command_name="$1"
  shift || true
  case "$command_name" in
    hook-run)
      run_hook_command "$@"
      ;;
    guard-run)
      server_guard_run "$@"
      ;;
    guard-require)
      server_guard_require "$@"
      ;;
    status)
      require_no_args "$command_name" "$@"
      render_colored_supervisor_status
      ;;
    menu)
      run_job_script "menu" "$@"
      ;;
    start)
      require_no_args "$command_name" "$@"
      server_guard_run "core_ready" -- run_supervisorctl_program_action start server
      ;;
    stop)
      require_no_args "$command_name" "$@"
      server_guard_run "core_ready" -- run_supervisorctl_program_action stop server
      ;;
    restart)
      if [[ "$#" -gt 0 ]] && is_non_flag_token "$1"; then
        case "$1" in
          force)
            shift
            set -- --force "$@"
            ;;
          player-check)
            shift
            set -- --player-check "$@"
            ;;
          no-player-check)
            shift
            set -- --no-player-check "$@"
            ;;
          help)
            shift
            set -- --help "$@"
            ;;
          *)
            echo "Unknown restart mode: $1 (use: force|player-check|no-player-check)" >&2
            exit 1
            ;;
        esac
      fi
      run_job_script "restart" "$@"
      ;;
    update)
      if [[ "$#" -gt 0 ]] && is_non_flag_token "$1"; then
        case "$1" in
          force)
            shift
            set -- --force "$@"
            ;;
          check)
            shift
            set -- --check-only "$@"
            ;;
          player-check)
            shift
            set -- --player-check "$@"
            ;;
          no-player-check)
            shift
            set -- --no-player-check "$@"
            ;;
          help)
            shift
            set -- --help "$@"
            ;;
          *)
            echo "Unknown update mode: $1 (use: force|check|player-check|no-player-check)" >&2
            exit 1
            ;;
        esac
      fi
      run_job_or_supervisor_start "updater" "updater" "$@"
      ;;
    scheduled-backup)
      require_no_args "$command_name" "$@"
      run_job_or_supervisor_start "backup" "backup"
      ;;
    backup)
      if [[ "$#" -eq 0 ]]; then
        run_job_script "backup" --mode manual
        return $?
      fi
      if is_non_flag_token "$1"; then
        case "$1" in
          manual|scheduled|list)
            local _mode
            _mode="$1"
            shift
            set -- --mode "$_mode" "$@"
            ;;
          inspect)
            local _zip
            _zip="${2-}"
            [[ -n "$_zip" ]] || {
              echo "Missing zip filename (usage: backup inspect <zip>)" >&2
              exit 1
            }
            shift 2
            set -- --mode inspect --zip "$_zip" "$@"
            ;;
          restore)
            local _zip _target
            _zip="${2-}"
            [[ -n "$_zip" ]] || {
              echo "Missing zip filename (usage: backup restore <zip> [savegame|enshrouded|manager|all])" >&2
              exit 1
            }
            if [[ $# -ge 3 && "${3#-}" == "$3" ]]; then
              _target="$3"
              shift 3
            else
              _target="all"
              shift 2
            fi
            set -- --mode restore --zip "$_zip" --restore "$_target" "$@"
            ;;
          help)
            shift
            set -- --help "$@"
            ;;
          *)
            echo "Unknown backup mode: $1 (use: manual|scheduled|list|inspect|restore)" >&2
            exit 1
            ;;
        esac
      fi
      run_job_script "backup" "$@"
      ;;
    backup-config)
      require_no_args "$command_name" "$@"
      run_job_script "backup" --mode manual --savegame false --enshrouded-config true --manager-config true --cleanup false
      ;;
    profile)
      if [[ "$#" -gt 0 ]] && is_non_flag_token "$1"; then
        case "$1" in
          manager|enshrouded)
            local _target _action _profile
            _target="$1"
            _action="${2-}"
            case "$_action" in
              apply)
                _profile="${3-}"
                [[ -n "$_profile" ]] || {
                  echo "Missing profile name (usage: profile $_target apply <profile>)" >&2
                  exit 1
                }
                shift 3
                set -- --target "$_target" --action apply --profile "$_profile" "$@"
                ;;
              reset)
                shift 2
                set -- --target "$_target" --action reset "$@"
                ;;
              *)
                echo "Unknown profile action: ${_action:-<empty>} (use: apply|reset)" >&2
                exit 1
                ;;
            esac
            ;;
          passwords|password-view)
            local _fmt
            _fmt="${2-}"
            if [[ -n "$_fmt" ]] && is_non_flag_token "$_fmt"; then
              shift 2
              set -- --password-view --format "$_fmt" "$@"
            else
              shift
              set -- --password-view "$@"
            fi
            ;;
          help)
            shift
            set -- --help "$@"
            ;;
          *)
            echo "Unknown profile mode: $1 (use: manager|enshrouded|passwords)" >&2
            exit 1
            ;;
        esac
      fi
      if [[ "$#" -eq 0 ]]; then
        echo "profile requires args (simple: profile <manager|enshrouded> <apply|reset> [profile])" >&2
        exit 1
      fi
      run_job_script "profile" "$@"
      ;;
    password-view)
      if [[ "$#" -gt 0 ]] && is_non_flag_token "$1"; then
        case "$1" in
          text|json)
            local _fmt
            _fmt="$1"
            shift
            set -- --format "$_fmt" "$@"
            ;;
          help)
            shift
            set -- --help "$@"
            ;;
          *)
            echo "Unknown password-view mode: $1 (use: text|json)" >&2
            exit 1
            ;;
        esac
      fi
      run_job_script "profile" --password-view "$@"
      ;;
    env-validation)
      run_job_or_supervisor_start "env-validation" "env-validation" "$@"
      ;;
    scheduled-restart)
      if [[ "$#" -gt 0 ]] && is_non_flag_token "$1"; then
        case "$1" in
          force)
            shift
            set -- --force "$@"
            ;;
          player-check)
            shift
            set -- --player-check "$@"
            ;;
          no-player-check)
            shift
            set -- --no-player-check "$@"
            ;;
          help)
            shift
            set -- --help "$@"
            ;;
          *)
            echo "Unknown scheduled-restart mode: $1 (use: force|player-check|no-player-check)" >&2
            exit 1
            ;;
        esac
      fi
      run_job_or_supervisor_start "restart" "restart" "$@"
      ;;
    bootstrap)
      if [[ "$#" -gt 0 ]] && is_non_flag_token "$1"; then
        local -a _bootstrap_args
        _bootstrap_args=()
        while [[ "$#" -gt 0 ]] && is_non_flag_token "$1"; do
          case "$1" in
            job)
              _bootstrap_args+=(--job)
              ;;
            no-update)
              _bootstrap_args+=(--no-update)
              ;;
            entrypoint)
              _bootstrap_args+=(--entrypoint)
              ;;
            help)
              _bootstrap_args+=(--help)
              ;;
            *)
              echo "Unknown bootstrap mode: $1 (use: job|no-update|entrypoint)" >&2
              exit 1
              ;;
          esac
          shift
        done
        set -- "${_bootstrap_args[@]}" "$@"
      fi
      run_job_or_supervisor_start "bootstrap" "bootstrap" "$@"
      ;;
    cron)
      if [[ "$#" -gt 0 ]] && is_non_flag_token "$1"; then
        case "$1" in
          sync)
            shift
            set -- --sync "$@"
            ;;
          start|stop|restart|status)
            local _svc
            _svc="$1"
            shift
            set -- --service "$_svc" "$@"
            ;;
          help)
            shift
            set -- --help "$@"
            ;;
          *)
            echo "Unknown cron mode: $1 (use: sync|start|stop|restart|status)" >&2
            exit 1
            ;;
        esac
      fi
      run_job_script "cron" "$@"
      ;;
    help|--help|-h)
      usage_commands
      ;;
    *)
      echo "Unknown command: $command_name" >&2
      usage_commands >&2
      exit 1
      ;;
  esac
}

run_server_command_entry() {
  local command_name command_rc post_rc
  command_name="${1:-help}"
  shift || true

  if [[ "$command_name" == "help" || "$command_name" == "--help" || "$command_name" == "-h" || "$command_name" == "hook-run" || "$command_name" == "guard-run" || "$command_name" == "guard-require" ]]; then
    run_server_command "$command_name" "$@"
    return $?
  fi

  info "Running server command: ${command_name}"
  load_server_command_hooks
  run_hook "server command pre" "${SERVER_COMMAND_PRE_HOOK:-}"
  run_server_command "$command_name" "$@"
  command_rc=$?
  run_hook "server command post" "${SERVER_COMMAND_POST_HOOK:-}"
  post_rc=$?
  if [[ "$command_rc" -ne 0 ]]; then
    warn "Server command failed: ${command_name} (rc=${command_rc})"
    return "$command_rc"
  fi
  if [[ "$post_rc" -ne 0 ]]; then
    warn "Server command post-hook failed: ${command_name} (rc=${post_rc})"
    return "$post_rc"
  fi
  info "Server command complete: ${command_name}"
  return "$post_rc"
}

