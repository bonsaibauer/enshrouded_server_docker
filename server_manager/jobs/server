#!/usr/bin/env bash

SCRIPT_DIR="$(cd -P "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" >/dev/null 2>&1 && pwd)"
# shellcheck source=server_manager/lib/log
. "${SCRIPT_DIR}/../lib/log"

CORE_SERVER_JOB="${CORE_SERVER_JOB:-${SCRIPT_DIR}/../jobs_core/server}"

usage() {
  cat <<'EOF'
Usage:
  server [start|stop|status]
  server --stop-safe [--shutdown-timeout <seconds>]
  server --players-check [--player-check|--no-player-check] [--query-port <port>]
  server --render-banner
  server --startup-ui

Notes:
  - Server process-control and guard/hook execution are delegated to jobs_core/server.
EOF
}

require_executable() {
  local file
  file="$1"
  [[ -x "$file" ]] || fatal "Command is not executable: $file"
}

delegate_core_server() {
  require_executable "$CORE_SERVER_JOB"
  "$CORE_SERVER_JOB" "$@"
}

main() {
  local command_name
  command_name="${1-}"

  if [[ -z "$command_name" ]]; then
    delegate_core_server
    exit $?
  fi
  shift || true

  case "$command_name" in
    --help|-h|help)
      usage
      exit 0
      ;;
    # Internal process-control and guard APIs.
    hook-run|guard-run|guard-require|status|start|stop|--stop-safe|--players-check|--render-banner|--startup-ui|run)
      delegate_core_server "$command_name" "$@"
      ;;
    # Additional core flags are handled by jobs_core/server.
    --*)
      delegate_core_server "$command_name" "$@"
      ;;
    *)
      fatal "Unknown server command: $command_name"
      ;;
  esac
}

main "$@"
