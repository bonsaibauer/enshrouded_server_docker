startup_ui_state() {
  local program
  program="$1"
  run_supervisorctl status "$program" 2>/dev/null | awk 'NR==1{print $2}'
}

server_wait_for_supervisor_jobs() {
  local deadline now started_at elapsed remaining state_crond state_rsyslogd state_bootstrap report_idx step
  local -a report_steps

  if ! run_supervisorctl pid >/dev/null 2>&1; then
    warn "Supervisor is not reachable - skipping startup wait"
    return 0
  fi

  report_steps=(5 10 15 20 30 45 60)
  step=90
  while [[ "$step" -lt "$STARTUP_UI_WAIT_TIMEOUT" ]]; do
    report_steps+=("$step")
    step=$(( step + 30 ))
  done
  report_idx=0
  started_at="$(date +%s)"
  deadline=$(( started_at + STARTUP_UI_WAIT_TIMEOUT ))
  while :; do
    state_crond="$(startup_ui_state "crond")"
    state_rsyslogd="$(startup_ui_state "rsyslogd")"
    state_bootstrap="$(startup_ui_state "bootstrap")"

    if [[ "$state_crond" == "RUNNING" ]] \
      && [[ "$state_rsyslogd" == "RUNNING" ]] \
      && [[ "$state_bootstrap" == "RUNNING" || "$state_bootstrap" == "EXITED" ]]; then
      info "Supervisor startup jobs are ready (crond=${state_crond}, rsyslogd=${state_rsyslogd}, bootstrap=${state_bootstrap})"
      return 0
    fi

    now="$(date +%s)"
    elapsed=$(( now - started_at ))
    remaining=$(( deadline - now ))
    if [[ "$remaining" -lt 0 ]]; then
      remaining=0
    fi

    if [[ "$report_idx" -lt "${#report_steps[@]}" ]] && [[ "$elapsed" -ge "${report_steps[$report_idx]}" ]]; then
      info "Waiting for supervisor startup jobs... (${elapsed}s elapsed, ${remaining}s remaining; crond=${state_crond:-unknown}, rsyslogd=${state_rsyslogd:-unknown}, bootstrap=${state_bootstrap:-unknown})"
      while [[ "$report_idx" -lt "${#report_steps[@]}" ]] && [[ "$elapsed" -ge "${report_steps[$report_idx]}" ]]; do
        report_idx=$(( report_idx + 1 ))
      done
    fi

    if [[ "$now" -ge "$deadline" ]]; then
      warn "Timeout while waiting for supervisor startup jobs (crond=${state_crond:-unknown}, rsyslogd=${state_rsyslogd:-unknown}, bootstrap=${state_bootstrap:-unknown})"
      return 0
    fi

    sleep "$STARTUP_UI_WAIT_INTERVAL"
  done
}

server_startup_ui() {
  server_render_banner
  info "Waiting for supervisor startup jobs..."
  server_wait_for_supervisor_jobs
}

parse_server_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --wait-download)
        WAIT_FOR_DOWNLOAD="true"
        shift
        ;;
      --no-wait-download)
        WAIT_FOR_DOWNLOAD="false"
        shift
        ;;
      --shutdown-timeout)
        timeout="${2-}"
        if [[ -z "$timeout" || ! "$timeout" =~ ^[0-9]+$ || "$timeout" -le 0 ]]; then
          fatal "Invalid --shutdown-timeout value: ${2-}"
        fi
        shift 2
        ;;
      --stop-safe)
        SERVER_ACTION="stop-safe"
        shift
        ;;
      --players-check)
        SERVER_ACTION="players-check"
        shift
        ;;
      --player-check)
        CHECK_PLAYERS="true"
        shift
        ;;
      --no-player-check)
        CHECK_PLAYERS="false"
        shift
        ;;
      --query-port)
        SERVER_QUERY_PORT="${2-}"
        if [[ -z "$SERVER_QUERY_PORT" || ! "$SERVER_QUERY_PORT" =~ ^[0-9]+$ || "$SERVER_QUERY_PORT" -le 0 ]]; then
          fatal "Invalid --query-port value: ${2-}"
        fi
        shift 2
        ;;
      --render-banner)
        SERVER_ACTION="render-banner"
        shift
        ;;
      --startup-ui)
        SERVER_ACTION="startup-ui"
        shift
        ;;
      --help|-h)
        usage_server
        exit 0
        ;;
      *)
        fatal "Unknown argument: $1"
        ;;
    esac
  done
}

wait_for_server_download() {
  while :; do
    if [[ -f "$enshrouded_server" ]]; then
      break
    else
      debug "enshrouded Server is not yet downloaded - waiting"
      sleep 7
    fi
  done
}

run_server_process() {
  info "Running server"
  debug "Server config ServerName:${ENSHROUDED_NAME} - ServerQueryPort:${ENSHROUDED_QUERY_PORT}"

  export WINEDEBUG="$WINEDEBUG"
  export STEAM_COMPAT_CLIENT_INSTALL_PATH="/home/enshrouded/.steam/steam"
  export STEAM_COMPAT_DATA_PATH="$install_path/steamapps/compatdata/$steam_app_id"
  export WINEPREFIX="${STEAM_COMPAT_DATA_PATH}/pfx"
  export WINETRICKS="/usr/local/bin/winetricks"

  chmod +x "$enshrouded_server"
  proton runinprefix "$enshrouded_server" &
  enshrouded_server_pid=$!
  echo "$enshrouded_server_pid" >"$enshrouded_server_pidfile"

  wait "$enshrouded_server_pid"
  debug "server with PID $enshrouded_server_pid stopped"

  cleanup_wine
  "${SCRIPT_DIR}/server" hook-run "server post" "${SERVER_POST_HOOK:-}"
  info "Shutdown complete"
  exit 0
}

cleanup_wine() {
  debug "cleanup wineserver"
  WINEPREFIX="$install_path/steamapps/compatdata/$steam_app_id/pfx/" /usr/local/bin/files/bin/wineserver -k
  clearLock "$enshrouded_server_pidfile"
}

shutdown() {
  local shutdown_timeout shutdown_step_timeout
  local -a child_pids
  debug "Received signal to shut down server"
  if [[ "$enshrouded_server_pid" -eq -1 ]]; then
    debug "enshrouded server is not running yet - aborting startup"
    exit
  fi
  shutdown_step_timeout="${SERVER_SHUTDOWN_STEP_TIMEOUT:-20}"
  if [[ -z "$shutdown_step_timeout" || ! "$shutdown_step_timeout" =~ ^[0-9]+$ || "$shutdown_step_timeout" -le 0 ]]; then
    shutdown_step_timeout=20
  fi
  info "Shutting down enshrouded server with PID $enshrouded_server_pid"
  if [[ -d "/proc/$enshrouded_server_pid" ]]; then
    kill -"$kill_signal" "$enshrouded_server_pid" 2>/dev/null || true
  fi
  if command -v pgrep >/dev/null 2>&1; then
    mapfile -t child_pids < <(pgrep -P "$enshrouded_server_pid" 2>/dev/null || true)
    if [[ "${#child_pids[@]}" -gt 0 ]]; then
      kill -"$kill_signal" "${child_pids[@]}" 2>/dev/null || true
    fi
  fi
  if command -v pkill >/dev/null 2>&1; then
    pkill -"$kill_signal" -f "[e]nshrouded_server(\\.exe)?" 2>/dev/null || true
  fi

  shutdown_timeout=$(( $(date +%s) + shutdown_step_timeout ))
  while [[ -d "/proc/$enshrouded_server_pid" ]]; do
    if [[ "$(date +%s)" -gt "$shutdown_timeout" ]]; then
      shutdown_timeout=$(( $(date +%s) + shutdown_step_timeout ))
      warn "Timeout while waiting for server to shut down - sending SIG${kill_signal} to PID ${enshrouded_server_pid}"
      if [[ -d "/proc/$enshrouded_server_pid" ]]; then
        kill -"$kill_signal" "$enshrouded_server_pid" 2>/dev/null || true
      fi
      if command -v pgrep >/dev/null 2>&1; then
        mapfile -t child_pids < <(pgrep -P "$enshrouded_server_pid" 2>/dev/null || true)
        if [[ "${#child_pids[@]}" -gt 0 ]]; then
          kill -"$kill_signal" "${child_pids[@]}" 2>/dev/null || true
        fi
      fi
      if command -v pkill >/dev/null 2>&1; then
        pkill -"$kill_signal" -f "[e]nshrouded_server(\\.exe)?" 2>/dev/null || true
      fi
      case "$kill_signal" in
        INT)
          kill_signal=TERM
          ;;
        *)
          kill_signal=KILL
          ;;
      esac
    fi
    debug "Waiting for enshrouded Server with PID $enshrouded_server_pid to shut down"
    sleep 2
  done
}

server_stop_safe() {
  local deadline now
  if ! is_supervisor_running "server"; then
    return 0
  fi

  info "Stopping server"
  server_guard_run "core_ready" -- run_supervisorctl stop server >/dev/null 2>&1 || true

  deadline=$(( $(date +%s) + timeout ))
  while is_supervisor_running "server"; do
    now="$(date +%s)"
    if [[ "$now" -ge "$deadline" ]]; then
      fatal "Timeout while stopping server"
    fi
    sleep 1
  done
}

server_resolve_query_port() {
  local port cfg_file
  port="${SERVER_QUERY_PORT:-${ENSHROUDED_QUERY_PORT:-}}"
  if [[ -z "$port" ]]; then
    cfg_file="${install_path}/enshrouded_server.json"
    if command -v jq >/dev/null 2>&1 && [[ -f "$cfg_file" ]]; then
      port="$(jq -r '.queryPort | if . == null then empty else tostring end' "$cfg_file" 2>/dev/null || true)"
    fi
  fi
  [[ -n "$port" ]] || port="15637"
  printf "%s" "$port"
}

server_players_check() {
  local port connected_players
  if [[ "$CHECK_PLAYERS" == "false" ]]; then
    return 0
  fi

  port="$(server_resolve_query_port)"
  if [[ -z "$port" || ! "$port" =~ ^[0-9]+$ || "$port" -le 0 ]]; then
    fatal "Invalid query port: ${port:-<empty>}"
  fi

  connected_players="$(python3 -c "
try:
    import a2s
    print(len(a2s.players(('127.0.0.1',$port))))
except Exception:
    print('null')
")"

  debug "[players-check] connected_players: $connected_players"
  if [[ -n "$connected_players" && "$connected_players" != "null" && "$connected_players" -gt 0 ]]; then
    return 10
  fi
  return 0
}

main() {
  local command_name invoked_name players_rc

  invoked_name="$(basename "$0")"
  if [[ "$invoked_name" != "server" ]]; then
    if is_server_command "$invoked_name"; then
      run_server_command_entry "$invoked_name" "$@"
      return $?
    fi
    fatal "Unknown command alias: $invoked_name"
  fi

  if [[ $# -gt 0 && "${1#-}" == "$1" ]] && is_server_command "$1"; then
    command_name="$1"
    shift || true
    run_server_command_entry "$command_name" "$@"
    return $?
  fi

  parse_server_args "$@"

  case "$SERVER_ACTION" in
    stop-safe)
      info "Running server action: stop-safe"
      server_stop_safe
      info "Server action complete: stop-safe"
      return 0
      ;;
    players-check)
      local players_check_query_port
      players_check_query_port="$(server_resolve_query_port)"
      info "Running server action: players-check (check_players=${CHECK_PLAYERS}, query_port=${players_check_query_port})"
      server_players_check
      players_rc=$?
      if [[ "$players_rc" -eq 10 ]]; then
        info "Players check result: active players detected"
        info "Server action complete: players-check (rc=10, players_active=true)"
      else
        info "Server action complete: players-check (rc=${players_rc})"
      fi
      return $players_rc
      ;;
    render-banner)
      info "Running server action: render-banner"
      server_render_banner
      info "Server action complete: render-banner"
      return 0
      ;;
    startup-ui)
      info "Running server action: startup-ui"
      server_startup_ui
      info "Server action complete: startup-ui"
      return 0
      ;;
  esac

  info "Running server action: run (wait_for_download=${WAIT_FOR_DOWNLOAD})"
  init_runtime_env
  cd "$install_path" || fatal "Could not cd $install_path"
  enshrouded_server="$install_path/$enshrouded_binary_path"
  "${SCRIPT_DIR}/server" hook-run "server pre" "${SERVER_PRE_HOOK:-}"
  if [[ "$WAIT_FOR_DOWNLOAD" == "true" ]]; then
    wait_for_server_download
  elif [[ ! -f "$enshrouded_server" ]]; then
    fatal "Server binary not found: $enshrouded_server (use --wait-download)"
  fi
  run_server_process
}

trap shutdown SIGINT SIGTERM
main "$@"
