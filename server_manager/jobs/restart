#!/usr/bin/env bash

SCRIPT_DIR="$(cd -P "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" >/dev/null 2>&1 && pwd)"
# shellcheck source=server_manager/lib/log
. "${SCRIPT_DIR}/../lib/log"
# shellcheck source=server_manager/jobs_core/profile
. "${SCRIPT_DIR}/../jobs_core/profile"

COMMAND_ROOT="${COMMAND_ROOT:-${SCRIPT_DIR}/../commands}"
RESTART_EXEC_MODE="${RESTART_EXEC_MODE:-manual}"

CHECK_PLAYER_CMD="${COMMAND_ROOT}/check/check-player"
MANUAL_RESTART_CMD="${COMMAND_ROOT}/manual/restart"
FORCE_RESTART_CMD="${COMMAND_ROOT}/force/force-restart"
SCHEDULED_RESTART_CMD="${COMMAND_ROOT}/scheduled/scheduled-restart"

usage() {
  cat <<'EOF'
Usage:
  restart

Configuration via ENV:
  RESTART_EXEC_MODE=manual|force|scheduled
EOF
}

require_executable() {
  local file
  file="$1"
  [[ -x "$file" ]] || fatal "Command is not executable: $file"
}

restart_read_check_players() {
  local value
  value="$(resolve_from_env_or_manager "RESTART_CHECK_PLAYERS" ".restartCheckPlayers" "true")"
  case "$(echo "$value" | tr '[:upper:]' '[:lower:]' | xargs)" in
    true|false) echo "$(echo "$value" | tr '[:upper:]' '[:lower:]' | xargs)" ;;
    *)
      warn "Invalid restartCheckPlayers value: ${value:-<empty>} (fallback=true)"
      echo "true"
      ;;
  esac
}

restart_read_query_port() {
  local cfg_file port
  port="${ENSHROUDED_QUERY_PORT:-}"
  if [[ -z "$port" ]]; then
    cfg_file="${install_path}/enshrouded_server.json"
    if command -v jq >/dev/null 2>&1 && [[ -f "$cfg_file" ]]; then
      port="$(jq -r '.queryPort | if . == null then empty else tostring end' "$cfg_file" 2>/dev/null || true)"
    fi
  fi
  [[ -n "$port" ]] || port="15637"
  echo "$port"
}

run_optional_player_check() {
  local check_players query_port check_rc
  check_players="$1"
  query_port="$2"

  if [[ "$RESTART_EXEC_MODE" == "force" ]]; then
    info "Skipping player check because RESTART_EXEC_MODE=force"
    return 0
  fi
  if [[ "$check_players" != "true" ]]; then
    info "Skipping player check because restartCheckPlayers=false"
    return 0
  fi

  require_executable "$CHECK_PLAYER_CMD"
  "$CHECK_PLAYER_CMD" --player-check --query-port "$query_port"
  check_rc=$?
  case "$check_rc" in
    0)
      info "Player check passed (no active players)"
      return 0
      ;;
    10)
      warn "Player check detected active players - restart skipped"
      return 10
      ;;
    *)
      fatal "Player check failed (rc=$check_rc)"
      ;;
  esac
}

dispatch_restart_command() {
  case "$RESTART_EXEC_MODE" in
    force)
      require_executable "$FORCE_RESTART_CMD"
      "$FORCE_RESTART_CMD"
      ;;
    scheduled)
      require_executable "$SCHEDULED_RESTART_CMD"
      "$SCHEDULED_RESTART_CMD"
      ;;
    manual|"")
      require_executable "$MANUAL_RESTART_CMD"
      "$MANUAL_RESTART_CMD"
      ;;
    *)
      fatal "Invalid RESTART_EXEC_MODE: $RESTART_EXEC_MODE (expected: manual|force|scheduled)"
      ;;
  esac
}

main() {
  local check_players query_port

  case "${1-}" in
    --help|-h|help)
      usage
      exit 0
      ;;
    "")
      ;;
    *)
      fatal "restart job does not accept arguments"
      ;;
  esac

  check_players="$(restart_read_check_players)"
  query_port="$(restart_read_query_port)"

  info "Running restart job dispatcher (mode=${RESTART_EXEC_MODE}, check_players=${check_players}, query_port=${query_port})"

  if run_optional_player_check "$check_players" "$query_port"; then
    dispatch_restart_command
    exit $?
  fi

  # run_optional_player_check returns 10 when players are active.
  success "Restart job complete (no action required)"
  exit 0
}

main "$@"
