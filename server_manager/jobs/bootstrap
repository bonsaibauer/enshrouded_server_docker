#!/usr/bin/env bash

SCRIPT_DIR="$(cd -P "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" >/dev/null 2>&1 && pwd)"
# shellcheck source=server_manager/lib/log
. "${SCRIPT_DIR}/../lib/log"

COMMAND_ROOT="${COMMAND_ROOT:-${SCRIPT_DIR}/../commands}"
BOOTSTRAP_SKIP_UPDATE="${BOOTSTRAP_SKIP_UPDATE:-false}"
BOOTSTRAP_UPDATE_MODE="${BOOTSTRAP_UPDATE_MODE:-manual}"

usage() {
  cat <<'EOF'
Usage:
  bootstrap

Configuration via ENV:
  BOOTSTRAP_SKIP_UPDATE=true|false
  BOOTSTRAP_UPDATE_MODE=manual|scheduled|force
EOF
}

require_executable() {
  local file
  file="$1"
  [[ -x "$file" ]] || fatal "Command is not executable: $file"
}

run_job_mode() {
  local update_cmd
  update_cmd="${COMMAND_ROOT}/manual/update"
  case "$BOOTSTRAP_UPDATE_MODE" in
    force) update_cmd="${COMMAND_ROOT}/force/force-update" ;;
    scheduled) update_cmd="${COMMAND_ROOT}/scheduled/scheduled-update" ;;
    manual|"") update_cmd="${COMMAND_ROOT}/manual/update" ;;
    *) fatal "Invalid BOOTSTRAP_UPDATE_MODE: $BOOTSTRAP_UPDATE_MODE" ;;
  esac

  require_executable "${COMMAND_ROOT}/manual/env-init-runtime"
  require_executable "${COMMAND_ROOT}/check/check-all-env"
  require_executable "$update_cmd"
  require_executable "${SCRIPT_DIR}/cron"

  info "Bootstrap: initialize runtime ENV"
  "${COMMAND_ROOT}/manual/env-init-runtime"

  info "Bootstrap: validate ENV"
  "${COMMAND_ROOT}/check/check-all-env"

  info "Bootstrap: sync cron configuration"
  CRON_EXEC_ACTION=sync "${SCRIPT_DIR}/cron"

  if [[ "$BOOTSTRAP_SKIP_UPDATE" == "true" ]]; then
    info "Bootstrap: update step skipped (BOOTSTRAP_SKIP_UPDATE=true)"
    return 0
  fi

  info "Bootstrap: run update command (${BOOTSTRAP_UPDATE_MODE})"
  "$update_cmd"
}

main() {
  case "${1-}" in
    --help|-h|help)
      usage
      exit 0
      ;;
    "")
      ;;
    *)
      fatal "bootstrap job does not accept arguments"
      ;;
  esac

  info "Running bootstrap job dispatcher"
  run_job_mode
}

main "$@"
