#!/usr/bin/env bash

SCRIPT_DIR="$(cd -P "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" >/dev/null 2>&1 && pwd)"
ENV_VALIDATION_JOB="${ENV_VALIDATION_JOB:-${SCRIPT_DIR}/../../jobs_core/env}"

usage() {
  cat <<'EOF'
Usage:
  check-env <ENV_NAME> [ENV_VALUE]
  check-env --name <ENV_NAME> [--value <ENV_VALUE>]

Notes:
  If ENV_VALUE is omitted, the current environment value of ENV_NAME is used.
EOF
}

main() {
  local var_name var_value explicit_value
  explicit_value="false"
  var_name=""
  var_value=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)
        var_name="${2-}"
        [[ -n "$var_name" ]] || {
          echo "Missing value for --name" >&2
          exit 1
        }
        shift 2
        ;;
      --value)
        var_value="${2-}"
        explicit_value="true"
        shift 2
        ;;
      --help|-h|help)
        usage
        exit 0
        ;;
      *)
        if [[ -z "$var_name" ]]; then
          var_name="$1"
        elif [[ "$explicit_value" == "false" ]]; then
          var_value="$1"
          explicit_value="true"
        else
          echo "Unknown argument: $1" >&2
          usage >&2
          exit 1
        fi
        shift
        ;;
    esac
  done

  [[ -n "$var_name" ]] || {
    usage >&2
    exit 1
  }

  [[ "$var_name" =~ ^[A-Z0-9_]+$ ]] || {
    echo "Invalid ENV name: $var_name" >&2
    exit 1
  }

  if [[ "$explicit_value" != "true" ]]; then
    var_value="${!var_name-}"
  fi

  [[ -x "$ENV_VALIDATION_JOB" ]] || {
    echo "ENV validation job is not executable: $ENV_VALIDATION_JOB" >&2
    exit 1
  }

  "$ENV_VALIDATION_JOB" check "$var_name" "$var_value"
}

main "$@"


