#!/usr/bin/env bash

SCRIPT_DIR="$(cd -P "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" >/dev/null 2>&1 && pwd)"
# shellcheck source=server_manager/jobs_core/profile
. "${SCRIPT_DIR}/../../jobs_core/profile"

CHECK_OUTPUT_FORMAT="human"

usage() {
  cat <<'EOF'
Usage:
  check-password [--format human|json]

Exit codes:
  0  All user group passwords are set (or no groups exist)
  10 At least one user group password is empty
EOF
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --format)
        CHECK_OUTPUT_FORMAT="${2-}"
        [[ -n "$CHECK_OUTPUT_FORMAT" ]] || fatal "Missing value for --format"
        shift 2
        ;;
      --json)
        CHECK_OUTPUT_FORMAT="json"
        shift
        ;;
      --help|-h|help)
        usage
        exit 0
        ;;
      *)
        fatal "Unknown argument: $1"
        ;;
    esac
  done

  case "$CHECK_OUTPUT_FORMAT" in
    human|json) ;;
    *)
      fatal "Invalid output format: $CHECK_OUTPUT_FORMAT (expected: human|json)"
      ;;
  esac
}

main() {
  local config_file groups_json missing_count total_count
  config_file="${install_path}/enshrouded_server.json"

  parse_args "$@"
  require_cmd jq

  [[ -f "$config_file" ]] || fatal "Missing enshrouded_server.json at $config_file"
  jq -e 'type == "object"' "$config_file" >/dev/null 2>&1 || fatal "Invalid JSON: $config_file"

  groups_json="$(
    jq -c '
      if (.userGroups // [] | type) != "array" then
        []
      else
        .userGroups | to_entries | map({
          index: .key,
          name: (.value.name // "<unnamed>"),
          has_password: (((.value.password // "") | tostring) != "")
        })
      end
    ' "$config_file"
  )"

  total_count="$(jq -r 'length' <<<"$groups_json")"
  missing_count="$(jq -r '[.[] | select(.has_password == false)] | length' <<<"$groups_json")"

  if [[ "$CHECK_OUTPUT_FORMAT" == "json" ]]; then
    jq -cn \
      --arg config "$config_file" \
      --argjson groups "$groups_json" \
      --argjson total "$total_count" \
      --argjson missing "$missing_count" \
      '{
        config: $config,
        total_groups: $total,
        missing_passwords: $missing,
        groups: $groups
      }'
  else
    echo "Config: $config_file"
    echo "Total Groups: $total_count"
    echo "Missing Passwords: $missing_count"
    if [[ "$total_count" -gt 0 ]]; then
      jq -r '.[] | "- Group \(.index): \(.name) -> " + (if .has_password then "set" else "missing" end)' <<<"$groups_json"
    fi
  fi

  if [[ "$missing_count" -gt 0 ]]; then
    exit 10
  fi
  exit 0
}

main "$@"


