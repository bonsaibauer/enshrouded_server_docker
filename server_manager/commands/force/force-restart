#!/usr/bin/env bash

SCRIPT_DIR="$(cd -P "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" >/dev/null 2>&1 && pwd)"
CORE_RESTART_JOB="${CORE_RESTART_JOB:-${SCRIPT_DIR}/../../jobs_core/restart}"

usage() {
  cat <<'EOF'
Usage:
  force-restart
EOF
}

main() {
  case "${1-}" in
    --help|-h|help)
      usage
      exit 0
      ;;
    "")
      ;;
    *)
      echo "force-restart does not accept arguments" >&2
      usage >&2
      exit 1
      ;;
  esac

  [[ -x "$CORE_RESTART_JOB" ]] || {
    echo "Restart job is not executable: $CORE_RESTART_JOB" >&2
    exit 1
  }

  "$CORE_RESTART_JOB" --force
}

main "$@"


