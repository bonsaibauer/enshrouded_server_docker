  "actions": {
    "show_status": {
      "command": "jobs/server",
      "args": [
        "status"
      ]
    },
    "start_server": {
      "command": "jobs/server",
      "args": [
        "start"
      ],
      "confirm": "Start server now?"
    },
    "stop_server": {
      "command": "jobs/server",
      "args": [
        "stop"
      ],
      "confirm": "Stop server now?"
    },
    "restart_manual": {
      "command": "commands/manual/restart",
      "confirm": "Run manual restart now?"
    },
    "restart_force": {
      "command": "commands/force/force-restart",
      "confirm": "Run force restart now?"
    },
    "restart_scheduled": {
      "command": "commands/scheduled/scheduled-restart",
      "confirm": "Run scheduled restart flow now?"
    },
    "update_manual": {
      "command": "commands/manual/update",
      "confirm": "Run manual update now?"
    },
    "update_force": {
      "command": "commands/force/force-update",
      "confirm": "Run force update now?"
    },
    "update_scheduled": {
      "command": "commands/scheduled/scheduled-update",
      "confirm": "Run scheduled update flow now?"
    },
    "backup_manual": {
      "command": "commands/manual/backup"
    },
    "backup_manual_all": {
      "command": "commands/manual/backup-all"
    },
    "backup_manual_config": {
      "command": "commands/manual/backup-config"
    },
    "backup_scheduled": {
      "command": "commands/scheduled/scheduled-backup"
    },
    "backup_scheduled_all": {
      "command": "commands/scheduled/scheduled-backup-all"
    },
    "backup_scheduled_config": {
      "command": "commands/scheduled/scheduled-backup-config"
    },
    "backup_list": {
      "command": "commands/check/check-backup-list"
    },
    "profile_check_password": {
      "command": "commands/check/check-password"
    },
    "env_check_all": {
      "command": "commands/check/check-all-env"
    },
    "env_init_runtime": {
      "command": "commands/manual/env-init-runtime",
      "confirm": "Initialize runtime config files from ENV values?"
    },
    "cron_sync": {
      "command": "jobs/cron",
      "env": {
        "CRON_EXEC_ACTION": "sync"
      }
    },
    "cron_status": {
      "command": "jobs/cron",
      "env": {
        "CRON_EXEC_ACTION": "status"
      }
    },
    "cron_restart": {
      "command": "jobs/cron",
      "env": {
        "CRON_EXEC_ACTION": "restart"
      },
      "confirm": "Restart cron service now?"
    },
    "run_bootstrap": {
      "command": "jobs/bootstrap",
      "confirm": "Run bootstrap sequence now?"
    }
  }
}
