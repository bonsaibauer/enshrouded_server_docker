{
  "start_screen": "main",
  "menus": [
    {
      "id": "main",
      "title": "Main Menu",
      "subtitle": "Dispatch actions to jobs/commands without embedding business logic in the menu.",
      "prompt": "Select option",
      "options": [
        {
          "key": "1",
          "label": "Show supervisor status",
          "type": "action",
          "action": "show_status"
        },
        {
          "key": "2",
          "label": "Start server",
          "type": "action",
          "action": "start_server"
        },
        {
          "key": "3",
          "label": "Stop server",
          "type": "action",
          "action": "stop_server"
        },
        {
          "key": "4",
          "label": "Restart menu",
          "type": "screen",
          "next": "restart"
        },
        {
          "key": "5",
          "label": "Update menu",
          "type": "screen",
          "next": "update"
        },
        {
          "key": "6",
          "label": "Backup menu",
          "type": "screen",
          "next": "backup"
        },
        {
          "key": "7",
          "label": "Profile menu",
          "type": "screen",
          "next": "profile"
        },
        {
          "key": "8",
          "label": "Environment menu",
          "type": "screen",
          "next": "env"
        },
        {
          "key": "9",
          "label": "Cron menu",
          "type": "screen",
          "next": "cron"
        },
        {
          "key": "b",
          "label": "Run bootstrap",
          "type": "action",
          "action": "run_bootstrap"
        },
        {
          "key": "q",
          "label": "Quit",
          "type": "exit"
        }
      ]
    },
    {
      "id": "restart",
      "title": "Restart Menu",
      "prompt": "Select option",
      "options": [
        {
          "key": "1",
          "label": "Manual restart",
          "type": "action",
          "action": "restart_manual"
        },
        {
          "key": "2",
          "label": "Force restart",
          "type": "action",
          "action": "restart_force"
        },
        {
          "key": "3",
          "label": "Scheduled restart flow",
          "type": "action",
          "action": "restart_scheduled"
        },
        {
          "key": "m",
          "label": "Back to main menu",
          "type": "screen",
          "next": "main"
        },
        {
          "key": "q",
          "label": "Quit",
          "type": "exit"
        }
      ]
    },
    {
      "id": "update",
