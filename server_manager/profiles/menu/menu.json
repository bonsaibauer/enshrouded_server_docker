          "type": "action",
          "action": "profile_check_password"
        },
        {
          "key": "m",
          "label": "Back to main menu",
          "type": "screen",
          "next": "main"
        },
        {
          "key": "q",
          "label": "Quit",
          "type": "exit"
        }
      ]
    },
    {
      "id": "env",
      "title": "Environment Menu",
      "prompt": "Select option",
      "options": [
        {
          "key": "1",
          "label": "Check all ENV values",
          "type": "action",
          "action": "env_check_all"
        },
        {
          "key": "2",
